    <system:String x:Key="window_help_patchnotes_desc">See what changed in this version.</system:String>
    <system:String x:Key="window_help_faq_desc">Answers on songify.rocks.</system:String>
    <system:String x:Key="window_help_github_desc">Report bugs and request features.</system:String>
