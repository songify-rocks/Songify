    <system:String x:Key="menu_setup_wizard">Getting started</system:String>
    <system:String x:Key="menu_widget_gallery">Widget gallery</system:String>
    <system:String x:Key="menu_widget_generator">Widget generator</system:String>
    <system:String x:Key="window_overview_widget_title">Stream widget</system:String>
    <system:String x:Key="window_overview_widget_body">Show the current song in OBS with a browser overlay. The gallery includes Premium widgets; the generator is a simpler customizer.</system:String>
    <system:String x:Key="window_overview_widget_open_gallery">Browse widgets</system:String>
    <system:String x:Key="window_overview_widget_open_generator">Customize</system:String>
    <system:String x:Key="window_overview_widget_open_local">Local preview</system:String>
