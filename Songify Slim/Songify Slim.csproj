<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Songify_Slim</RootNamespace>
    <AssemblyName>Songify</AssemblyName>
    <Description>Spotify Song Fetcher</Description>
    <Company>Songify.Rocks</Company>
    <Product>Songify</Product>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Single source of truth for AssemblyVersion, FileVersion, and InformationalVersion. -->
    <Version>2.0.0.4</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- WinForms is still referenced (folder pickers). Trimming hard-fails (NETSDK1175). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Disable leftover ClickOnce publish/manifest generation (no longer used). -->
    <GenerateManifests>false</GenerateManifests>
    <BootstrapperEnabled>false</BootstrapperEnabled>
  </PropertyGroup>
  <!-- Drop IntelliSense XML from the publish folder (WebView2 etc.). -->
  <Target Name="Songify_RemoveXmlFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <ApplicationIcon>Resources\songify.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>Songify_Slim.App</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" />
    <Reference Include="Microsoft.Build.Utilities.v4.0" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.IdentityModel" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\thirdparty.json" />
    <EmbeddedResource Include="Resources\WebSocketDocs.html" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="songify.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\img\default-1.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official">
      <Version>1.9.2</Version>
    </PackageReference>
    <PackageReference Include="Common.Logging">
      <Version>3.4.1</Version>
    </PackageReference>
    <PackageReference Include="EmbedIO">
      <Version>3.5.2</Version>
    </PackageReference>
    <PackageReference Include="FuzzySharp">
      <Version>2.0.2</Version>
    </PackageReference>
    <PackageReference Include="HtmlAgilityPack">
      <Version>1.12.4</Version>
    </PackageReference>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF">
      <Version>2.0.0-rc4.5</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting">
      <Version>10.0.7</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions">
      <Version>10.0.7</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging">
      <Version>10.0.7</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options">
      <Version>10.0.7</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications">
      <Version>7.1.3</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2">
      <Version>1.0.3912.50</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf">
      <Version>1.1.142</Version>
    </PackageReference>
    <PackageReference Include="Resource.Embedder">
      <Version>2.2.0</Version>
    </PackageReference>
    <PackageReference Include="SpotifyAPI.Web">
      <Version>7.4.2</Version>
    </PackageReference>
    <PackageReference Include="SpotifyAPI.Web.Auth">
      <Version>7.4.2</Version>
    </PackageReference>
    <PackageReference Include="TwitchLib.Api">
      <Version>3.10.2</Version>
    </PackageReference>
    <PackageReference Include="TwitchLib.Client">
      <Version>4.0.1</Version>
    </PackageReference>
    <PackageReference Include="TwitchLib.EventSub.Websockets">
      <Version>0.8.0</Version>
    </PackageReference>
    <PackageReference Include="WPF-UI">
      <Version>4.3.0</Version>
    </PackageReference>
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    <PackageReference Include="YamlDotNet">
      <Version>17.1.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\songify.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\songifyBeta.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\img\1.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\img\100.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\img\1000.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\img\10000.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\img\5000.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="default_site\favicon.ico" />
    <EmbeddedResource Include="default_site\index.html" />
    <EmbeddedResource Include="default_site\songify.png" />
    <EmbeddedResource Include="default_site\spotify.png" />
  </ItemGroup>
</Project>

