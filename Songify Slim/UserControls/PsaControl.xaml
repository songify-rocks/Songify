<UserControl
    x:Class="Songify_Slim.UserControls.PsaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="0"
    d:DesignHeight="200"
    d:DesignWidth="340"
    mc:Ignorable="d">
    <Border
        x:Name="BorderMotd"
        Padding="12,10"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Severity + mark read  -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <Border
                    x:Name="BorderSeverity"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    DockPanel.Dock="Left">
                    <TextBlock
                        x:Name="TbSeverity"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>
                <ui:Button
                    x:Name="btnRead"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="BtnRead_OnClick"
                    DockPanel.Dock="Right"
                    ToolTip="{DynamicResource uc_psa_mark_as_read}">
                    <ui:SymbolIcon
                        x:Name="badgeIcon"
                        Width="14"
                        Height="14"
                        Symbol="MailRead24" />
                </ui:Button>
            </DockPanel>

            <!--  Author · date  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap">
                <Run x:Name="TbAuthor" />
                <Run Text=" · " />
                <Run x:Name="TbDate" />
            </TextBlock>

            <!--  Body (outer flyout scrolls; avoid nested ScrollViewer)  -->
            <TextBlock
                x:Name="TbMessage"
                Grid.Row="2"
                Margin="0,10,0,0"
                FontSize="13"
                Hyperlink.RequestNavigate="TbMessage_OnRequestNavigate"
                LineHeight="18"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
