<UserControl
    x:Class="Songify_Slim.UserControls.PsaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Songify_Slim.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="0"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        x:Name="BorderMotd"
        Padding="15"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        BorderThickness="2"
        CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal">
                <TextBlock Text="{DynamicResource uc_psa_issued}" />
                <TextBlock x:Name="TbDate" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock Text="{DynamicResource uc_psa_severity}" />
                <Border
                    x:Name="BorderSeverity"
                    Margin="4,0,0,0"
                    Padding="6,0"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock x:Name="TbSeverity" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                Orientation="Horizontal">
                <TextBlock Text="{DynamicResource uc_psa_author}" />
                <TextBlock x:Name="TbAuthor" Margin="4,0,0,0" />
                <Button
                    x:Name="btnRead"
                    Margin="6,0"
                    Click="BtnRead_OnClick"
                    
                    ToolTip="{DynamicResource uc_psa_mark_as_read}">
                    <Button.Content>
                        <ui:SymbolIcon x:Name="badgeIcon" Width="12" Height="12" Symbol="MailRead24" />
                    </Button.Content>
                </Button>
            </StackPanel>
            <ScrollViewer
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="6"
                VerticalAlignment="Stretch">
                <TextBlock
                    x:Name="TbMessage"
                    Margin="6"
                    Hyperlink.RequestNavigate="TbMessage_OnRequestNavigate"
                    TextAlignment="Justify"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>