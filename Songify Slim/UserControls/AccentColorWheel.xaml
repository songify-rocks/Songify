<UserControl
    x:Class="Songify_Slim.UserControls.AccentColorWheel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="204"
    Height="176"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="WheelHost"
            Width="168"
            Height="168"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            ClipToBounds="True"
            PreviewMouseLeftButtonDown="WheelHost_OnPreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="WheelHost_OnPreviewMouseLeftButtonUp"
            PreviewMouseMove="WheelHost_OnPreviewMouseMove"
            LostMouseCapture="WheelHost_OnLostMouseCapture"
            SizeChanged="WheelHost_OnSizeChanged">
            <Image
                x:Name="ImgWheel"
                RenderOptions.BitmapScalingMode="HighQuality"
                Stretch="Fill" />
            <Border
                x:Name="ValueOverlay"
                Background="Black"
                IsHitTestVisible="False"
                Opacity="0" />
            <Canvas x:Name="ThumbLayer" IsHitTestVisible="False">
                <Ellipse
                    x:Name="Thumb"
                    Width="14"
                    Height="14"
                    Stroke="White"
                    StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect
                            BlurRadius="4"
                            Opacity="0.6"
                            ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
        <Grid Grid.Column="1" Margin="8,12,0,12">
            <Border
                x:Name="ValueTrack"
                Width="10"
                HorizontalAlignment="Center"
                CornerRadius="5" />
            <Slider
                x:Name="SldValue"
                Width="22"
                HorizontalAlignment="Center"
                IsMoveToPointEnabled="True"
                LostMouseCapture="SldValue_OnLostMouseCapture"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                PreviewMouseLeftButtonUp="SldValue_OnPreviewMouseLeftButtonUp"
                ValueChanged="SldValue_OnValueChanged" />
        </Grid>
    </Grid>
</UserControl>
