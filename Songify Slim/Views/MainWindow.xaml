<Window
    x:Class="Songify_Slim.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:general="clr-namespace:Songify_Slim.Util.General"
    xmlns:local="clr-namespace:Songify_Slim.Properties"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_main_title}"
    Width="600"
    Height="285"
    MinWidth="600"
    MinHeight="285"
    d:Title="{x:Static local:Resources.window_main_title}"
    Closed="Window_Closed"
    Closing="Window_Closing"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    LocationChanged="Window_LocationChanged"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    ResizeMode="CanResizeWithGrip"
    SizeChanged="MainWindow_OnSizeChanged"
    StateChanged="Window_StateChanged"
    TextOptions.TextFormattingMode="Display"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <general:CombineStringConverter x:Key="CombineStringConverter" />
        <util:BooleanToVisibilityConverter xmlns:util="clr-namespace:Songify_Slim.Util" x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image
            x:Name="AppIcon"
            Width="0"
            Height="0"
            Visibility="Collapsed" />
        <Border
            x:Name="BetaPanel"
            Width="60"
            Margin="6"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Black"
            CornerRadius="10"
            Visibility="Collapsed"
            Panel.ZIndex="50">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                d:Text="{x:Static local:Resources.common_beta}"
                FontSize="15"
                FontWeight="Bold"
                Foreground="White"
                Text="{DynamicResource common_beta}" />
        </Border>
        <StackPanel
            Margin="0,4,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Panel.ZIndex="50">
            <Button
                x:Name="BtnFontSizeDown"
                Height="26"
                Padding="8,2"
                Click="BtnFontSizeDown_Click"
                Content="A-"
                Focusable="False" />
            <Button
                x:Name="BtnFontSizeUp"
                Height="26"
                Margin="4,0,0,0"
                Padding="8,2"
                Click="BtnFontSizeUp_Click"
                Content="A+"
                Focusable="False" />
            <TextBlock
                x:Name="TbFontSize"
                Margin="8,0,4,0"
                VerticalAlignment="Center" />
        </StackPanel>
        <Grid
            x:Name="GrdDisclaimer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            Visibility="Collapsed"
            Panel.ZIndex="1001">
            <Button
                x:Name="BtnDisclaimerClose"
                Width="26"
                Height="26"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Content="{x:Static local:Resources.common_close_x}"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                Click="BtnDisclaimerClose_Click"
                Content="{DynamicResource common_close_x}"
                Visibility="Collapsed" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    MaxWidth="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    Songify is completely free.<LineBreak />
                    We are committed to keeping it accessible to everyone. To support our development and keep the app running smoothly, we rely on the generosity of our users.<LineBreak /><LineBreak />
                    If you love using our app and wish to help us continue our work, consider making a donation.</TextBlock>
                <Button
                    Width="250"
                    Margin="0,15,0,0"
                    Background="#FFFF5E5B"
                    Click="BtnPaypal_Click"
                    Foreground="White">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" />
                            <TextBlock
                                d:Text="{x:Static local:Resources.window_main_support_kofi}"
                                FontSize="18"
                                Text="{DynamicResource window_main_support_kofi}" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="TbDisclaimerDismiss"
                Margin="5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Text="" />
        </Grid>
        <Menu
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,0,0"
            Padding="0"
            VerticalAlignment="Top"
            Background="Transparent">
            <MenuItem d:Header="{x:Static local:Resources.menu_file}" Header="{DynamicResource menu_file}">
                <MenuItem
                    d:Header="{x:Static local:Resources.menu_file_settings}"
                    Click="BtnSettings_Click"
                    Header="{DynamicResource menu_file_settings}" />

                <MenuItem
                    d:Header="{x:Static local:Resources.menu_file_widget}"
                    Click="BtnWidget_Click"
                    Header="{DynamicResource menu_file_widget}" />
                <MenuItem
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    d:Header="{x:Static local:Resources.menu_file_patchnotes}"
                    Click="BtnPatchNotes_Click"
                    Header="{DynamicResource menu_file_patchnotes}" />
                <MenuItem d:Header="{x:Static local:Resources.menu_file_help}" Header="{DynamicResource menu_file_help}">
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_faq}"
                        Click="BtnFAQ_Click"
                        Header="{DynamicResource menu_faq}" />
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_github}"
                        Click="BtnGitHub_Click"
                        Header="{DynamicResource menu_github}" />
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_discord}"
                        Click="BtnDiscord_Click"
                        Header="{DynamicResource menu_discord}" />
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_help_log_folder}"
                        Click="BtnLogFolderClick"
                        Header="{DynamicResource menu_help_log_folder}" />
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_help_app_folder}"
                        Click="BtnAppFolderClick"
                        Header="{DynamicResource menu_help_app_folder}" />
                    <MenuItem
                        d:Header="{x:Static local:Resources.menu_help_about}"
                        Click="BtnAboutClick"
                        Header="{DynamicResource menu_help_about}" />
                </MenuItem>
                <MenuItem
                    x:Name="MiUpdate"
                    d:Header="{x:Static local:Resources.menu_file_check_for_updates}"
                    Click="Mi_Update_OnClick"
                    Header="{DynamicResource menu_file_check_for_updates}" />
                <MenuItem
                    x:Name="MiExit"
                    d:Header="{x:Static local:Resources.menu_file_exit}"
                    Click="Mi_Exit_Click"
                    Header="{DynamicResource menu_file_exit}" />
            </MenuItem>
            <MenuItem
                d:Header="{x:Static local:Resources.menu_twitch}"
                d:ToolTip="{x:Static local:Resources.menu_twitch_connect_tooltip}"
                Header="{DynamicResource menu_twitch}"
                IsTabStop="False"
                ToolTip="{DynamicResource menu_twitch_connect_tooltip}">
                <MenuItem
                    x:Name="MiTwitchApi"
                    d:Header="{x:Static local:Resources.menu_twitch_login}"
                    Click="Mi_TwitchAPI_Click"
                    Header="{DynamicResource menu_twitch_login}" />
                <MenuItem
                    x:Name="MiTwitchConnect"
                    d:Header="{x:Static local:Resources.menu_twitch_connect}"
                    Click="BtnTwitch_Click"
                    Header="{DynamicResource menu_twitch_connect}"
                    Tag="Connect" />
                <MenuItem
                    x:Name="MiTwitchCheckOnlineStatus"
                    d:Header="{x:Static local:Resources.menu_twitch_check_online_status}"
                    Click="Mi_TwitchCheckOnlineStatus_OnClick"
                    Header="{DynamicResource menu_twitch_check_online_status}" />
            </MenuItem>
            <MenuItem d:Header="{x:Static local:Resources.menu_song_requests}" Header="{DynamicResource menu_song_requests}">
                <MenuItem
                    x:Name="MiQueue"
                    d:Header="{x:Static local:Resources.menu_song_requests_queue_window}"
                    Click="Mi_Queue_Click"
                    Header="{DynamicResource menu_song_requests_queue_window}"
                    Tag="Window" />
                <MenuItem
                    d:Header="{x:Static local:Resources.menu_song_requests_queue_browser}"
                    Click="Mi_Queue_Click"
                    Header="{DynamicResource menu_song_requests_queue_browser}"
                    Tag="Browser" />
                <MenuItem
                    x:Name="MiQueueClear"
                    d:Header="{x:Static local:Resources.menu_song_requests_clear_queue}"
                    Click="Mi_QueueClear_Click"
                    Header="{DynamicResource menu_song_requests_clear_queue}" />
                <MenuItem
                    x:Name="MiBlacklist"
                    d:Header="{x:Static local:Resources.menu_song_requests_block_list}"
                    Click="Mi_Blacklist_Click"
                    Header="{DynamicResource menu_song_requests_block_list}" />
            </MenuItem>
            <MenuItem d:Header="{x:Static local:Resources.menu_history}" Header="{DynamicResource menu_history}">
                <MenuItem
                    d:Header="{x:Static local:Resources.menu_history_window}"
                    Click="BtnHistory_Click"
                    Header="{DynamicResource menu_history_window}"
                    Tag="Window" />
            </MenuItem>
            <MenuItem d:Header="{x:Static local:Resources.menu_view}" Header="{DynamicResource menu_view}">
                <MenuItem
                    d:Header="{x:Static local:Resources.menu_view_console}"
                    Click="BtnMenuViewConsole_Click"
                    Header="{DynamicResource menu_view_console}" />

                <MenuItem
                    d:Header="{x:Static local:Resources.menu_view_user_list}"
                    Click="BtnMenuViewUserList_Click"
                    Header="{DynamicResource menu_view_user_list}" />
                <MenuItem
                    d:Header="{x:Static local:Resources.menu_view_webserver_url}"
                    Click="BtnWebServerUrl_Click"
                    Header="{DynamicResource menu_view_webserver_url}"
                    ToolTip="Track JSON: http://localhost:PORT/ — WebSocket tester: http://localhost:PORT/ws-docs (replace PORT with your server port)." />
            </MenuItem>
        </Menu>

        <!--  Persistent Spotify error banner (survives restarts for rate/quota)  -->
        <Border
            x:Name="BrdSpotifyPersistentIssue"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,36,0,0"
            Padding="10,6"
            Background="#FF3B2F2F"
            BorderBrush="#FFAA4444"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <Grid Panel.ZIndex="100000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueTitle"
                        FontWeight="Bold"
                        Foreground="White"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueBody"
                        Margin="0,2,0,0"
                        Foreground="White"
                        Opacity="0.95"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueEta"
                        Margin="0,2,0,0"
                        Foreground="White"
                        Opacity="0.9"
                        TextWrapping="Wrap" />
                    <Expander
                        x:Name="ExpSpotifyPersistentIssues"
                        Margin="0,6,0,0"
                        Foreground="White"
                        Header="More…"
                        IsExpanded="False">
                        <ScrollViewer MaxHeight="140">
                            <StackPanel x:Name="PnlSpotifyPersistentIssues" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="10,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    Click="BtnSpotifyPersistentIssueDismiss_Click"
                    Content="×"
                    FontSize="16"
                    Foreground="White"
                    ToolTip="Dismiss" />
            </Grid>
        </Border>
        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="0,3,6,0"
            HorizontalAlignment="Right"
            Orientation="Vertical">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                <ComboBox
                    x:Name="CbxSource"
                    Width="116"
                    Padding="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    DisplayMemberPath="Name"
                    IsTabStop="False"
                    SelectedIndex="0"
                    SelectedValuePath="Value" />
                <Grid x:Name="Badge" Margin="12,0,8,0"><Button
                        Width="26"
                        Height="26"
                        Click="BtnMotd_Click">
                        <Button.Content>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="BadgeIcon" Width="12" Height="12" Symbol="Alert24" />
                            </StackPanel>
                        </Button.Content>
                    </Button><TextBlock x:Name="BadgeText" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Margin="0,-4,-4,0" /></Grid>
            </StackPanel>
            <StackPanel
                x:Name="StkSpotifyTestMode"
                Margin="0,4,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="Visible">
                <ui:ToggleSwitch
                    x:Name="TglTestMode"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0"
                    Padding="0"
                    Content="Test Mode"
                    Checked="TglTestMode_OnToggled" Unchecked="TglTestMode_OnToggled" />
                <Button
                    Width="10"
                    MinWidth="0"
                    Margin="8,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="ButtonBase_OnClick"
                    Content="?"
                    ToolTip="To help combat Spotify Rate Limits, Spotify fetching is now limited to either being live on Twitch or enabled Test Mode (disables after 5 minutes)." />
            </StackPanel>
            <StackPanel
                x:Name="StkWindowsMediaSessions"
                Margin="0,4,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBlock
                    Margin="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Session" />
                <ComboBox
                    x:Name="CbxWindowsMediaSession"
                    MinWidth="200"
                    MaxWidth="280"
                    Padding="2"
                    VerticalAlignment="Top"
                    d:ToolTip="{x:Static local:Resources.window_main_windows_media_session_tooltip}"
                    DisplayMemberPath="DisplayName"
                    DropDownOpened="CbxWindowsMediaSession_DropDownOpened"
                    IsTabStop="False"
                    SelectedValuePath="Aumid"
                    SelectionChanged="CbxWindowsMediaSession_SelectionChanged"
                    ToolTip="{DynamicResource window_main_windows_media_session_tooltip}" />
                <Button
                    x:Name="BtnWindowsMediaSessionRefresh"
                    Width="28"
                    Height="28"
                    Margin="4,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    d:ToolTip="{x:Static local:Resources.window_main_windows_media_session_refresh_tooltip}"
                    Click="BtnWindowsMediaSessionRefresh_Click"
                    Focusable="False"
                    ToolTip="{DynamicResource window_main_windows_media_session_refresh_tooltip}">
                    <ui:SymbolIcon Width="16" Height="16" Symbol="ArrowSync24" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="100">
            <Border x:Name="FlyMotd" Width="320" HorizontalAlignment="Right" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4" LastChildFill="True">
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="{DynamicResource menu_notifications}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnFlyOutAllread" Width="40" Height="28" Margin="10,0" Click="BtnFlyOutAllread_OnClick" ToolTip="{DynamicResource common_mark_all_read}" Visibility="Hidden" Content="All" />
                            <Button x:Name="BtnFlyOutClose" Width="28" Height="28" Click="BtnFlyOutClose_OnClick" Content="X" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Margin="8">
                        <StackPanel x:Name="PnlMotds" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Grid
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Panel.ZIndex="-1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="GrdCover"
                Grid.Column="0"
                MinWidth="175"
                MinHeight="175"
                MaxWidth="175"
                MaxHeight="175"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,175,175" />
                </Grid.Clip>
                <Image
                    x:Name="ImgCover"
                    Margin="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="UniformToFill"
                    Visibility="Collapsed" />
                <Grid ClipToBounds="True">
                    <MediaElement
                        x:Name="CoverCanvas"
                        Margin="10"
                        VerticalAlignment="Center"
                        IsMuted="True"
                        LoadedBehavior="Manual"
                        MediaEnded="CoverCanvas_OnMediaEnded"
                        RenderTransformOrigin="0.5,0.5"
                        Stretch="UniformToFill"
                        UnloadedBehavior="Stop"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
            <Viewbox
                x:Name="ViewboxNowPlaying"
                Grid.Column="1"
                Margin="6"
                Stretch="Uniform"
                StretchDirection="Both">
                <Grid VerticalAlignment="Stretch">
                    <TextBlock
                        x:Name="TxtblockLiveoutput"
                        Width="1000"
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True"
                        Text="{DynamicResource common_now_playing_placeholder}"
                        TextAlignment="Left"
                        TextOptions.TextFormattingMode="Display"
                        TextWrapping="Wrap"
                        UseLayoutRounding="True" />
                </Grid>
            </Viewbox>
        </Grid>

        <Button
            x:Name="BtnSpotifyIdleBackoff"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,8,0"
            Padding="4,0"
            HorizontalAlignment="Center"
            d:ToolTip="{x:Static local:Resources.window_main_spotify_idle_polling_tooltip}"
            Click="BtnSpotifyIdleBackoff_Click"
            Cursor="Hand"
            Style="{StaticResource IconOnlyButton}"
            ToolTip="{DynamicResource window_main_spotify_idle_polling_tooltip}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="IndianRed" Symbol="Gauge24" />
                <TextBlock
                    x:Name="TbSpotifyIdleBackoff"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="IndianRed"
                    Text="Polling 20s (idle)" />
            </StackPanel>
        </Button>

        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,20,0,-5"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <!-- removed decorative arrow -->
            <Label d:Content="{x:Static local:Resources.window_main_pubsub_disabled}" Content="{DynamicResource window_main_pubsub_disabled}" />
        </StackPanel>
        <Button
            x:Name="BtnSupport"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            BorderThickness="0"
            Click="BtnPaypal_Click"
            Cursor="Hand"
            Foreground="White">
            <Button.Content>
                <Border
                    Padding="10,3"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="5"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,5,0" Symbol="Heart24" />
                        <TextBlock
                            VerticalAlignment="Center"
                            d:Text="{x:Static local:Resources.cta_support}"
                            Text="{DynamicResource cta_support}" />
                    </StackPanel>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform x:Name="RotateTransform" Angle="0" CenterX="62.5" CenterY="11" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Name="wiggle">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        AutoReverse="True"
                                        BeginTime="0:0:0"
                                        RepeatBehavior="Forever"
                                        Storyboard.TargetName="RotateTransform"
                                        Storyboard.TargetProperty="Angle"
                                        From="-2"
                                        To="2"
                                        Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Button.Content>
        </Button>
        <DockPanel
            x:Name="SbMain"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="20"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            LastChildFill="True"
            ScrollViewer.CanContentScroll="True"
            UseLayoutRounding="False">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush.NonActive}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Border
                Height="20"
                Padding="5,0,12,0"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StatusBarItem Grid.Column="0">
                        <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Click="ServiceIcon_Click"
                                Style="{StaticResource IconOnlyButton}"
                                Tag="TwitchBot"
                                ToolTip=""
                                ToolTipOpening="ServiceToolTipOpening">
                                <ui:SymbolIcon x:Name="IconTwitchBot" Width="14" Symbol="Live24" />
                            </Button>

                            <Button
                                Margin="0,0,8,0"
                                Click="ServiceIcon_Click"
                                Style="{StaticResource IconOnlyButton}"
                                Tag="TwitchAPI"
                                ToolTip=""
                                ToolTipOpening="ServiceToolTipOpening">
                                <ui:SymbolIcon x:Name="IconTwitchApi" Width="14" Symbol="Live24" />
                            </Button>

                            <Button
                                Margin="0,0,8,0"
                                Click="ServiceIcon_Click"
                                Style="{StaticResource IconOnlyButton}"
                                Tag="Spotify"
                                ToolTip=""
                                ToolTipOpening="ServiceToolTipOpening">
                                <ui:SymbolIcon x:Name="IconWebSpotify" Width="14" Symbol="MusicNote224" />
                            </Button>



                            <Button
                                Margin="0,0,8,0"
                                Click="ServiceIcon_Click"
                                Style="{StaticResource IconOnlyButton}"
                                Tag="PearDesktop"
                                ToolTip=""
                                ToolTipOpening="ServiceToolTipOpening">
                                <ui:SymbolIcon x:Name="IconPearDesktop" Width="14" Symbol="PlayCircle24" />
                            </Button>

                            <Button
                                Click="ServiceIcon_Click"
                                Style="{StaticResource IconOnlyButton}"
                                Tag="WebServer"
                                ToolTip=""
                                ToolTipOpening="ServiceToolTipOpening">
                                <ui:SymbolIcon x:Name="IconWebServer" Width="14" Symbol="Server24" />
                            </Button>
                        </StackPanel>
                    </StatusBarItem>
                    <DockPanel
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        LastChildFill="False">
                        <StatusBarItem Visibility="{Binding ApiMetrics.ShowTotalInStatusbar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ApiMetrics.TotalRequestsPerMinute, StringFormat=Spotify API Calls: {0} rpm}" />
                        </StatusBarItem>

                        <StatusBarItem
                            x:Name="LblStatus"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Visibility="Collapsed">
                            <StatusBar />
                        </StatusBarItem>
                        <StatusBarItem
                            Margin="0,-2,0,-2"
                            Padding="0"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <StatusBarItem
                                    x:Name="LblCopyright"
                                    d:Content="{x:Static local:Resources.window_main_copyright}"
                                    Content="{DynamicResource window_main_copyright}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StatusBarItem
                                    x:Name="LblCopyrightLink"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Hyperlink
                                        FontStyle="Normal"
                                        NavigateUri="https://songify.rocks"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        <Hyperlink.Foreground>
                                            <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                                        </Hyperlink.Foreground>
                                        Songify.Rocks
                                    </Hyperlink>
                                </StatusBarItem>
                            </StackPanel>
                        </StatusBarItem>
                    </DockPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>