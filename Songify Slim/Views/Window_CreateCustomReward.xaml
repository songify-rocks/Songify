<ui:FluentWindow
    x:Class="Songify_Slim.Views.WindowCreateCustomReward"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_createreward_title}"
    Width="440"
    MinWidth="400"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource window_createreward_title}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_createreward_title}" />
            <ui:TextBox
                x:Name="TbRewardName"
                Margin="0,0,0,14"
                PlaceholderText="{DynamicResource window_createreward_title}" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_createreward_prompt}" />
            <ui:TextBox
                x:Name="TbRewardPrompt"
                Margin="0,0,0,14"
                AcceptsReturn="True"
                MinLines="2"
                PlaceholderText="{DynamicResource window_createreward_prompt}"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_createreward_cost}" />
            <ui:NumberBox
                x:Name="NudRewardCost"
                Margin="0,0,0,14"
                ClearButtonEnabled="False"
                Minimum="1"
                SpinButtonPlacementMode="Hidden"
                Value="1" />

            <ui:ToggleSwitch
                x:Name="TglUserInputRequired"
                Margin="0,0,0,8"
                Content="{DynamicResource window_createreward_user_input_required}" />

            <TextBlock
                x:Name="LblStatus"
                Margin="0,8,0,0"
                FontSize="12"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="24,8,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="BtnCancel"
                MinWidth="88"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="BtnCancel_Click"
                Content="{DynamicResource common_cancel}" />
            <ui:Button
                x:Name="BtnCreateReward"
                MinWidth="120"
                Appearance="Primary"
                Click="BtnCreateReward_Click"
                Content="{DynamicResource window_createreward_create}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
