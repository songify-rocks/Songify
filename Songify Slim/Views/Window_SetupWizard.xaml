<ui:FluentWindow
    x:Class="Songify_Slim.Views.WindowSetupWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource setup_wizard_title}"
    Width="560"
    Height="560"
    MinWidth="480"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource setup_wizard_title}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="TxtStepLabel"
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!--  Welcome  -->
            <StackPanel x:Name="StepWelcome" Grid.Row="1">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_welcome_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_welcome_body}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource window_settings_system_language}" />
                <ComboBox
                    x:Name="CbxLanguage"
                    MinWidth="220"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Value"
                    SelectedValuePath="Key"
                    SelectionChanged="CbxLanguage_OnSelectionChanged" />
            </StackPanel>

            <!--  Player  -->
            <StackPanel
                x:Name="StepPlayer"
                Grid.Row="1"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_player_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_player_body}"
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="CbxPlayer"
                    MinWidth="260"
                    HorizontalAlignment="Left"
                    SelectionChanged="CbxPlayer_OnSelectionChanged" />
            </StackPanel>

            <!--  Spotify  -->
            <StackPanel
                x:Name="StepSpotify"
                Grid.Row="1"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_spotify_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_spotify_body}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{DynamicResource window_settings_client_id}" />
                <Grid Margin="0,0,0,12">
                    <TextBox
                        x:Name="TbClientId"
                        Margin="0,0,40,0"
                        TextChanged="TbClientId_OnTextChanged"
                        TextWrapping="NoWrap" />
                    <ui:Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Click="BtnSpotifyHelp_OnClick"
                        Content="{DynamicResource common_help}"
                        ToolTip="{DynamicResource setup_spotify_help_tooltip}" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="BtnSpotifyLink"
                        MinWidth="110"
                        Appearance="Primary"
                        Click="BtnSpotifyLink_OnClick"
                        Content="{DynamicResource window_settings_integration_link}" />
                </StackPanel>
                <TextBlock
                    x:Name="TxtSpotifyStatus"
                    Margin="0,16,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Twitch  -->
            <StackPanel
                x:Name="StepTwitch"
                Grid.Row="1"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_twitch_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_twitch_body}"
                    TextWrapping="Wrap" />
                <ui:Button
                    x:Name="BtnTwitchLogin"
                    MinWidth="140"
                    HorizontalAlignment="Left"
                    Appearance="Primary"
                    Click="BtnTwitchLogin_OnClick"
                    Content="{DynamicResource menu_twitch_login}" />
                <TextBlock
                    x:Name="TxtTwitchStatus"
                    Margin="0,16,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Output  -->
            <StackPanel
                x:Name="StepOutput"
                Grid.Row="1"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_output_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_output_body}"
                    TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="TxtOutputDirectory"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        IsReadOnly="True"
                        TextWrapping="NoWrap" />
                    <ui:Button
                        Grid.Column="1"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="BtnBrowseOutput_OnClick"
                        Content="{DynamicResource common_browse}" />
                    <ui:Button
                        Grid.Column="2"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Appearance="Secondary"
                        Click="BtnCopyOutput_OnClick"
                        ToolTip="{DynamicResource window_settings_copy_to_clipboard}">
                        <ui:SymbolIcon
                            Width="16"
                            Height="16"
                            Symbol="Copy24" />
                    </ui:Button>
                </Grid>
            </StackPanel>

            <!--  Done  -->
            <StackPanel
                x:Name="StepDone"
                Grid.Row="1"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_done_title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_done_body}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="PnlStatusChips" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="24,12,24,20"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <ui:Button
                    HorizontalAlignment="Left"
                    Appearance="Transparent"
                    Click="BtnSkip_OnClick"
                    Content="{DynamicResource setup_skip}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="BtnBack"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="BtnBack_OnClick"
                        Content="{DynamicResource setup_back}" />
                    <ui:Button
                        x:Name="BtnTour"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="BtnTour_OnClick"
                        Content="{DynamicResource setup_show_me_around}"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="BtnNext"
                        MinWidth="88"
                        Appearance="Primary"
                        Click="BtnNext_OnClick"
                        Content="{DynamicResource setup_next}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
