<ui:FluentWindow
    x:Class="Songify_Slim.Views.WindowSetupWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource setup_wizard_title}"
    Width="580"
    Height="620"
    MinWidth="500"
    MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource setup_wizard_title}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="TxtStepLabel"
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,16,0">
                    <!--  Welcome  -->
                    <StackPanel x:Name="StepWelcome" Grid.Row="1">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_welcome_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,20"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_welcome_body}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource window_settings_system_language}" />
                        <ComboBox
                            x:Name="CbxLanguage"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Value"
                            SelectedValuePath="Key"
                            SelectionChanged="CbxLanguage_OnSelectionChanged" />
                    </StackPanel>

                    <!--  Player  -->
                    <StackPanel
                        x:Name="StepPlayer"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_player_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_player_body}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="CbxPlayer"
                            MinWidth="260"
                            HorizontalAlignment="Left"
                            SelectionChanged="CbxPlayer_OnSelectionChanged" />
                    </StackPanel>

                    <!--  Spotify  -->
                    <StackPanel
                        x:Name="StepSpotify"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_spotify_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_spotify_body}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{DynamicResource window_settings_client_id}" />
                        <Grid Margin="0,0,0,12">
                            <TextBox
                                x:Name="TbClientId"
                                Margin="0,0,40,0"
                                TextChanged="TbClientId_OnTextChanged"
                                TextWrapping="NoWrap" />
                            <ui:Button
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Appearance="Transparent"
                                Click="BtnSpotifyHelp_OnClick"
                                Content="{DynamicResource common_help}"
                                ToolTip="{DynamicResource setup_spotify_help_tooltip}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                x:Name="BtnSpotifyLink"
                                MinWidth="110"
                                Appearance="Primary"
                                Click="BtnSpotifyLink_OnClick"
                                Content="{DynamicResource window_settings_integration_link}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TxtSpotifyStatus"
                            Margin="0,16,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Twitch  -->
                    <StackPanel
                        x:Name="StepTwitch"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_twitch_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_twitch_body}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            x:Name="BtnTwitchLogin"
                            MinWidth="140"
                            HorizontalAlignment="Left"
                            Appearance="Primary"
                            Click="BtnTwitchLogin_OnClick"
                            Content="{DynamicResource menu_twitch_login}" />
                        <TextBlock
                            x:Name="TxtTwitchStatus"
                            Margin="0,16,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Song requests  -->
                    <StackPanel
                        x:Name="StepRequests"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_requests_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_requests_body}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TxtRequestsNeedTwitch"
                            Margin="0,0,0,12"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource setup_requests_need_twitch}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <CheckBox
                            x:Name="ChkRequestsReward"
                            Margin="0,0,0,4"
                            Checked="ChkRequests_OnChanged"
                            Content="{DynamicResource setup_requests_reward}"
                            Unchecked="ChkRequests_OnChanged" />
                        <TextBlock
                            Margin="24,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_requests_reward_hint}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            x:Name="ChkRequestsCommand"
                            Margin="0,0,0,4"
                            Checked="ChkRequests_OnChanged"
                            Content="{DynamicResource setup_requests_command}"
                            Unchecked="ChkRequests_OnChanged" />
                        <TextBlock
                            Margin="24,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_requests_command_hint}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Pick rewards  -->
                    <StackPanel
                        x:Name="StepRewards"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_rewards_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_rewards_body}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_rewards_refund}"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="140"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Click="BtnCreateReward_OnClick"
                                Content="{DynamicResource setup_requests_create_reward}" />
                            <ui:Button
                                MinWidth="110"
                                Appearance="Secondary"
                                Click="BtnRefreshRewards_OnClick"
                                Content="{DynamicResource setup_rewards_refresh}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TxtRewardsStatus"
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="PnlRewardList" />
                    </StackPanel>

                    <!--  Request rules  -->
                    <StackPanel
                        x:Name="StepLimits"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_limits_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_limits_body}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="PnlLimitsWho">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource setup_limits_who}" />
                            <CheckBox
                                x:Name="ChkUlViewer"
                                Margin="0,0,0,4"
                                Checked="ChkUserLevel_OnChanged"
                                Content="{DynamicResource common_viewer}"
                                Tag="0"
                                Unchecked="ChkUserLevel_OnChanged" />
                            <CheckBox
                                x:Name="ChkUlFollower"
                                Margin="0,0,0,4"
                                Checked="ChkUserLevel_OnChanged"
                                Content="{DynamicResource common_follower}"
                                Tag="1"
                                Unchecked="ChkUserLevel_OnChanged" />
                            <CheckBox
                                x:Name="ChkUlSubscriber"
                                Margin="0,0,0,4"
                                Checked="ChkUserLevel_OnChanged"
                                Content="{DynamicResource common_subscriber}"
                                Tag="2"
                                Unchecked="ChkUserLevel_OnChanged" />
                            <CheckBox
                                x:Name="ChkUlVip"
                                Margin="0,0,0,4"
                                Checked="ChkUserLevel_OnChanged"
                                Content="{DynamicResource common_vip}"
                                Tag="5"
                                Unchecked="ChkUserLevel_OnChanged" />
                            <CheckBox
                                x:Name="ChkUlModerator"
                                Margin="0,0,0,8"
                                Checked="ChkUserLevel_OnChanged"
                                Content="{DynamicResource common_moderator}"
                                Tag="6"
                                Unchecked="ChkUserLevel_OnChanged" />
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource setup_limits_who_hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_limits_queue}" />
                        <ui:NumberBox
                            x:Name="NudMaxQueue"
                            Width="100"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            ClearButtonEnabled="False"
                            Maximum="100"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Hidden"
                            ValueChanged="NudMaxQueue_OnValueChanged" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_limits_queue_hint}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_later_title}" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_later_song_requests}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_later_rewards}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_later_commands}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_later_responses}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Songify API token  -->
                    <StackPanel
                        x:Name="StepToken"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_token_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_token_body}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            x:Name="BtnGetToken"
                            MinWidth="140"
                            HorizontalAlignment="Left"
                            Appearance="Primary"
                            Click="BtnGetToken_OnClick"
                            Content="{DynamicResource setup_token_get}" />
                        <TextBlock
                            Margin="0,16,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource window_settings_songify_api_token}" />
                        <PasswordBox
                            x:Name="PwbToken"
                            Margin="0,0,0,8"
                            PasswordChanged="PwbToken_OnPasswordChanged" />
                        <TextBlock
                            x:Name="TxtTokenStatus"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Output  -->
                    <StackPanel
                        x:Name="StepOutput"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_output_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_output_body}"
                            TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TxtOutputDirectory"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                IsReadOnly="True"
                                TextWrapping="NoWrap" />
                            <ui:Button
                                Grid.Column="1"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Click="BtnBrowseOutput_OnClick"
                                Content="{DynamicResource common_browse}" />
                            <ui:Button
                                Grid.Column="2"
                                Width="36"
                                Height="32"
                                Padding="0"
                                Appearance="Secondary"
                                Click="BtnCopyOutput_OnClick"
                                ToolTip="{DynamicResource window_settings_copy_to_clipboard}">
                                <ui:SymbolIcon
                                    Width="16"
                                    Height="16"
                                    Symbol="Copy24" />
                            </ui:Button>
                        </Grid>
                    </StackPanel>

                    <!--  Widget  -->
                    <StackPanel
                        x:Name="StepWidget"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_widget_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_widget_body}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            x:Name="ChkUseWidget"
                            Margin="0,0,0,4"
                            Checked="ChkUseWidget_OnChanged"
                            Content="{DynamicResource setup_widget_use}"
                            Unchecked="ChkUseWidget_OnChanged" />
                        <TextBlock
                            Margin="24,0,0,16"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_widget_use_hint}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="PnlWidgetActions" Visibility="Collapsed">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource setup_widget_gallery}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource setup_widget_gallery_hint}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                MinWidth="160"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left"
                                Appearance="Primary"
                                Click="BtnWidgetGallery_OnClick"
                                Content="{DynamicResource setup_widget_gallery}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource setup_widget_generator}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource setup_widget_generator_hint}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                MinWidth="160"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Click="BtnWidgetGenerator_OnClick"
                                Content="{DynamicResource setup_widget_generator}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource setup_widget_local}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource setup_widget_local_hint}"
                                TextWrapping="Wrap" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource setup_widget_port}" />
                                <ui:NumberBox
                                    x:Name="NudWidgetPort"
                                    Width="100"
                                    HorizontalAlignment="Right"
                                    ClearButtonEnabled="False"
                                    Maximum="65535"
                                    Minimum="1025"
                                    SpinButtonPlacementMode="Hidden"
                                    ValueChanged="NudWidgetPort_OnValueChanged" />
                            </Grid>
                            <ui:Button
                                MinWidth="160"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Click="BtnWidgetLocal_OnClick"
                                Content="{DynamicResource setup_widget_open_local}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Done  -->
                    <StackPanel
                        x:Name="StepDone"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource setup_done_title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource setup_done_body}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="PnlStatusChips" />
                <TextBlock
                    Margin="0,16,0,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource setup_later_title}" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_later_song_requests}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_later_rewards}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_later_commands}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource setup_later_responses}"
                    TextWrapping="Wrap" />
            </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="24,12,24,20"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <ui:Button
                    HorizontalAlignment="Left"
                    Appearance="Transparent"
                    Click="BtnSkip_OnClick"
                    Content="{DynamicResource setup_skip}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="BtnBack"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="BtnBack_OnClick"
                        Content="{DynamicResource setup_back}" />
                    <ui:Button
                        x:Name="BtnTour"
                        MinWidth="140"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="BtnTour_OnClick"
                        Content="{DynamicResource setup_show_me_around}"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="BtnNext"
                        MinWidth="88"
                        Appearance="Primary"
                        Click="BtnNext_OnClick"
                        Content="{DynamicResource setup_next}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
