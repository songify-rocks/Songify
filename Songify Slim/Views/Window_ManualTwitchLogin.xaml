<ui:FluentWindow
    x:Class="Songify_Slim.Views.WindowManualTwitchLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_manualtwitch_title}"
    Width="480"
    MinWidth="420"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="DlgTitleBar"
            Title="{DynamicResource window_manualtwitch_title}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_manualtwitch_instructions}"
                TextWrapping="Wrap" />

            <!--  Step 1  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_manualtwitch_step1}"
                TextWrapping="Wrap" />
            <ui:Button
                x:Name="BtnOpenTwitchLogin"
                Margin="0,0,0,16"
                HorizontalAlignment="Stretch"
                Appearance="Secondary"
                Click="Button_OpenTwitchLoginPage_Click"
                Content="{DynamicResource window_manualtwitch_open_login}" />

            <!--  Step 2  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_manualtwitch_step2}"
                TextWrapping="Wrap" />
            <PasswordBox
                x:Name="TextBoxTwitchCode"
                Margin="0,0,0,16"
                MinHeight="32" />

            <!--  Step 3  -->
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_manualtwitch_step3}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="24,8,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="BtnCancel"
                MinWidth="88"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="BtnCancel_Click"
                Content="{DynamicResource common_cancel}" />
            <ui:Button
                x:Name="BtnLinkAccounts"
                MinWidth="120"
                Appearance="Primary"
                Click="Button_LinkAccounts_Click"
                Content="{DynamicResource window_manualtwitch_link}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
