<Window
    x:Class="Songify_Slim.Views.WindowManualTwitchLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Songify_Slim.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource window_manualtwitch_title}"
    Width="553"
    Height="275"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.ColumnSpan="2"
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{DynamicResource window_manualtwitch_instructions}"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Text="{DynamicResource window_manualtwitch_step1}"
            TextWrapping="Wrap" />
        <Button
            Grid.Row="1"
            Grid.Column="1"
            Height="30"
            Margin="10,0"
            Click="Button_OpenTwitchLoginPage_Click"
            Content="{DynamicResource window_manualtwitch_open_login}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Text="{DynamicResource window_manualtwitch_step2}"
            TextWrapping="Wrap" />

        <PasswordBox
            x:Name="TextBoxTwitchCode"
            Grid.Row="2"
            Grid.Column="1"
            Height="30"
            Margin="10,0" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="10,0"
            VerticalAlignment="Center"
            Text="{DynamicResource window_manualtwitch_step3}"
            TextWrapping="Wrap" />
        <Button
            Grid.Row="3"
            Grid.Column="1"
            Height="30"
            Margin="10,0"
            Click="Button_LinkAccounts_Click"
            Content="{DynamicResource window_manualtwitch_link}" />

    </Grid>
</Window>
