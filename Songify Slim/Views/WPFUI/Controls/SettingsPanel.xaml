<UserControl
    x:Class="Songify_Slim.Views.WPFUI.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:general="clr-namespace:Songify_Slim.Util.General"
    xmlns:local="clr-namespace:Songify_Slim.Properties"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:userControls="clr-namespace:Songify_Slim.UserControls"
    Loaded="SettingsPanel_Loaded"
    Unloaded="SettingsPanel_Unloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <general:LastItemVisibilityConverter x:Key="LastItemVisibilityConverter" />
        <!--  Comfortable vertical rhythm now that row heights are Auto  -->
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type PasswordBox}}" TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="TextBoxTextBlock"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Style.Setters>
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="Padding" Value="0,0,0,0" />
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid
            x:Name="GridLoading"
            Background="#CC000000"
            Visibility="Collapsed"
            ZIndex="10001">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    x:Name="TbGridLoading"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="{x:Static local:Resources.window_settings_getting_ready}"
                    Foreground="White"
                    Text="{DynamicResource window_settings_getting_ready}" />
                <ui:ProgressRing Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
        <TabControl
            x:Name="TabCtrl"
            Margin="0"
            SelectionChanged="TabCtrl_OnSelectionChanged"
            TabStripPlacement="Left">
            <TabItem
                d:Header="{x:Static local:Resources.window_settings_tab_system}"
                Header="{DynamicResource window_settings_tab_system}"
                Tag="System">
                <ScrollViewer Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" Margin="0,0,15,12">
                        <!--  Language  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource window_settings_system_language}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12">
                                        <Hyperlink NavigateUri="https://translate.songify.rocks/" RequestNavigate="Hyperlink_OnRequestNavigate">
                                            Help us Translate!
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <ComboBox
                                    x:Name="CbxLanguage"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Value"
                                    SelectedValuePath="Key"
                                    SelectionChanged="ComboBox_SelectionChanged"
                                    TabIndex="1" />
                            </Grid>
                        </ui:Card>

                        <!--  Behavior  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_system_behavior}" />
                                <ui:ToggleSwitch
                                    x:Name="ChbxAutostart"
                                    Margin="0,0,0,8"
                                    Checked="ChbxAutostartChecked"
                                    Content="{DynamicResource window_settings_system_autostart}"
                                    Focusable="False"
                                    TabIndex="2"
                                    Unchecked="ChbxAutostartChecked" />
                                <ui:ToggleSwitch
                                    x:Name="ChbxMinimizeSystray"
                                    Margin="0,0,0,8"
                                    Checked="ChbxMinimizeSystrayChecked"
                                    Content="{DynamicResource window_settings_system_minimize}"
                                    Focusable="False"
                                    TabIndex="3"
                                    Unchecked="ChbxMinimizeSystrayChecked" />
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,180,0" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource window_settings_system_release_channel}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_system_release_channel_hint}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="CbxReleaseChannel"
                                        MinWidth="160"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="CbxReleaseChannel_SelectionChanged"
                                        TabIndex="4">
                                        <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_release_channel_stable}" Content="{DynamicResource window_settings_release_channel_stable}" />
                                        <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_release_channel_beta}" Content="{DynamicResource window_settings_release_channel_beta}" />
                                        <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_release_channel_dev}" Content="{DynamicResource window_settings_release_channel_dev}" />
                                    </ComboBox>
                                </Grid>
                                <ui:ToggleSwitch
                                    x:Name="ChbxOpenQueueOnStartup"
                                    Margin="0,0,0,8"
                                    Checked="ChbxOpenQueueOnStartup_Toggled"
                                    Content="{DynamicResource window_settings_system_open_queue_on_startup}"
                                    Focusable="False"
                                    TabIndex="5"
                                    Unchecked="ChbxOpenQueueOnStartup_Toggled" />
                                <ui:ToggleSwitch
                                    x:Name="TglDonationReminder"
                                    Margin="0,0,0,8"
                                    Checked="TglDonationReminder_OnToggled"
                                    Content="{DynamicResource window_settings_system_hide_premium_reminder}"
                                    Focusable="False"
                                    TabIndex="6"
                                    Unchecked="TglDonationReminder_OnToggled" />
                                <ui:ToggleSwitch
                                    x:Name="TglShowSpotifyToasts"
                                    Margin="0,0,0,8"
                                    Checked="TglShowSpotifyToasts_OnToggled"
                                    Content="{DynamicResource window_settings_spotify_show_toasts}"
                                    Focusable="False"
                                    TabIndex="7"
                                    ToolTip="{DynamicResource window_settings_spotify_show_toasts_tooltip}"
                                    Unchecked="TglShowSpotifyToasts_OnToggled" />
                                <ui:ToggleSwitch
                                    x:Name="TglUseDefaultBrowser"
                                    Checked="TglUseDefaultBrowser_OnToggled"
                                    Content="{DynamicResource window_settings_system_use_default_browser}"
                                    Focusable="False"
                                    TabIndex="8"
                                    Unchecked="TglUseDefaultBrowser_OnToggled" />
                                <!--  Kept for code-behind / future use  -->
                                <ui:ToggleSwitch
                                    x:Name="ToggleSwitchPrivacy"
                                    Checked="ToggleSwitchPrivacy_Toggled"
                                    Unchecked="ToggleSwitchPrivacy_Toggled"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ui:Card>

                        <!--  Appearance: theme, backdrop, UI scale  -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_tab_appearance}" />
                                <Grid Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource window_settings_appearance_theme}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_appearance_theme_hint}" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_appearance_theme_light}" />
                                        <ui:ToggleSwitch
                                            x:Name="ThemeToggleSwitch"
                                            Checked="ThemeToggleSwitchIsCheckedChanged"
                                            TabIndex="9"
                                            Unchecked="ThemeToggleSwitchIsCheckedChanged" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_appearance_theme_dark}" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource window_settings_appearance_backdrop}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_appearance_backdrop_hint}" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="CbxWindowBackdrop"
                                        MinWidth="160"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        SelectionChanged="CbxWindowBackdrop_OnSelectionChanged"
                                        TabIndex="10" />
                                </Grid>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{DynamicResource window_settings_appearance_scale}" />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource window_settings_appearance_scale_hint}"
                                        TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            x:Name="SliderUiScale"
                                            VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="0.25"
                                            LostMouseCapture="SliderUiScale_OnLostMouseCapture"
                                            Maximum="2"
                                            Minimum="1"
                                            PreviewMouseLeftButtonDown="SliderUiScale_OnPreviewPointerDown"
                                            PreviewMouseLeftButtonUp="SliderUiScale_OnPreviewPointerUp"
                                            SmallChange="0.05"
                                            TabIndex="11"
                                            TickFrequency="0.05"
                                            TickPlacement="None"
                                            ValueChanged="SliderUiScale_OnValueChanged" />
                                        <TextBlock
                                            x:Name="TbUiScaleValue"
                                            Grid.Column="1"
                                            MinWidth="48"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="100%"
                                            TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                d:Header="{x:Static local:Resources.window_settings_tab_output}"
                Header="{DynamicResource window_settings_tab_output}"
                Tag="Output">
                <ScrollViewer Padding="0,0,15,0">
                    <StackPanel MaxWidth="720" Margin="0,0,0,12">
                        <!--  Directory  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_output_directory}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="TxtbxOutputdirectory"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap" />
                                    <Button
                                        x:Name="BtnOutputdirectory"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,6,0"
                                        d:Content="{x:Static local:Resources.common_browse}"
                                        Click="BtnOutputdirectoryClick"
                                        Content="{DynamicResource common_browse}" />
                                    <Button
                                        x:Name="BtnCopyToClip"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        d:ToolTip="{x:Static local:Resources.window_settings_copy_to_clipboard}"
                                        Click="BtnCopyToClipClick"
                                        Focusable="False"
                                        ToolTip="{DynamicResource window_settings_copy_to_clipboard}">
                                        <ui:SymbolIcon
                                            Width="16"
                                            Height="16"
                                            Symbol="Copy24" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!--  Format  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_output_format}" />
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_output_format_hint}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="TxtbxOutputformat"
                                    d:ToolTip="{x:Static local:Resources.window_settings_output_format_hint}"
                                    TextChanged="TxtbxOutputformat_TextChanged"
                                    TextWrapping="NoWrap"
                                    ToolTip="{DynamicResource window_settings_output_format_hint}">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                x:Name="MenuBtnArtist"
                                                d:Header="{x:Static local:Resources.common_artist}"
                                                Click="MenuBtnArtist_Click"
                                                Header="{DynamicResource common_artist}"
                                                Tag="1" />
                                            <MenuItem
                                                x:Name="MenuBtnTitle"
                                                d:Header="{x:Static local:Resources.common_title}"
                                                Click="MenuBtnTitle_Click"
                                                Header="{DynamicResource common_title}"
                                                Tag="1" />
                                            <MenuItem
                                                x:Name="MenuBtnExtra"
                                                d:Header="{x:Static local:Resources.window_settings_extra}"
                                                Click="MenuBtnExtra_Click"
                                                Header="{DynamicResource window_settings_extra}"
                                                Tag="1" />
                                            <MenuItem
                                                x:Name="MenuBtnReq"
                                                d:Header="{x:Static local:Resources.common_requester}"
                                                Click="MenuBtnReq_Click"
                                                Header="{DynamicResource common_requester}"
                                                Tag="1" />
                                            <MenuItem
                                                x:Name="MenuBtnUrl"
                                                d:Header="{x:Static local:Resources.window_settings_url}"
                                                Click="MenuBtnUrl_Click"
                                                Header="{DynamicResource window_settings_url}"
                                                Tag="1" />
                                            <MenuItem
                                                x:Name="MenuBtnReturn"
                                                d:Header="{x:Static local:Resources.window_settings_new_line}"
                                                Click="MenuBtnReturn_Click"
                                                Header="{DynamicResource window_settings_new_line}"
                                                Tag="1" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox
                                        x:Name="ChbxSpaces"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        d:Content="{x:Static local:Resources.window_settings_output_add_spaces}"
                                        Checked="ChbxSpaces_Checked"
                                        Content="{DynamicResource window_settings_output_add_spaces}"
                                        Unchecked="ChbxSpaces_Checked" />
                                    <ui:NumberBox
                                        x:Name="NudSpaces"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ClearButtonEnabled="False"
                                        Minimum="1"
                                        SmallChange="1"
                                        ValueChanged="Nud_Spaces_ValueChanged" />
                                    <CheckBox
                                        x:Name="ChbxSpacesSplitFiles"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,8,0,0"
                                        d:Content="{x:Static local:Resources.window_settings_output_apply_to_split_files}"
                                        Checked="ChbxSpacesSplitFiles_Checked"
                                        Content="{DynamicResource window_settings_output_apply_to_split_files}"
                                        Unchecked="ChbxSpacesSplitFiles_Checked" />
                                </Grid>
                                <!--  Hidden legacy controls kept for code-behind  -->
                                <Label
                                    MinWidth="160"
                                    d:Content="{x:Static local:Resources.window_settings_output_format_chat}"
                                    Content="{DynamicResource window_settings_output_format_chat}"
                                    Visibility="Collapsed" />
                                <TextBox
                                    x:Name="TxtbxOutputformat2"
                                    TextChanged="TxtbxOutputformat2_TextChanged"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                x:Name="MenuBtnArtist2"
                                                Click="MenuBtnArtist_Click"
                                                Header="{DynamicResource common_artist}"
                                                Tag="2" />
                                            <MenuItem
                                                x:Name="MenuBtnTitle2"
                                                Click="MenuBtnTitle_Click"
                                                Header="{DynamicResource common_title}"
                                                Tag="2" />
                                            <MenuItem
                                                x:Name="MenuBtnExtra2"
                                                Click="MenuBtnExtra_Click"
                                                Header="{DynamicResource window_settings_extra}"
                                                Tag="2" />
                                            <MenuItem
                                                x:Name="MenuBtnReq2"
                                                Click="MenuBtnReq_Click"
                                                Header="{DynamicResource common_requester}"
                                                Tag="2" />
                                            <MenuItem
                                                x:Name="MenuBtnUrl2"
                                                Click="MenuBtnUrl_Click"
                                                Header="{DynamicResource window_settings_url}"
                                                Tag="2" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </StackPanel>
                        </ui:Card>

                        <!--  Pause  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_output_pause}" />
                                <ComboBox
                                    x:Name="CbPauseOptions"
                                    Margin="0,0,0,8"
                                    SelectionChanged="CbPauseOptions_SelectionChanged">
                                    <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_output_on_pause_do_nothing}" Content="{DynamicResource window_settings_output_on_pause_do_nothing}" />
                                    <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_output_on_pause_custom_text}" Content="{DynamicResource window_settings_output_on_pause_custom_text}" />
                                    <ComboBoxItem d:Content="{x:Static local:Resources.window_settings_output_on_pause_clear_all}" Content="{DynamicResource window_settings_output_on_pause_clear_all}" />
                                </ComboBox>
                                <ui:ToggleSwitch
                                    x:Name="tgl_KeepCover"
                                    Margin="0,0,0,8"
                                    Checked="Tgl_KeepCover_OnToggled"
                                    Content="{DynamicResource window_settings_keep_album_cover}"
                                    Unchecked="Tgl_KeepCover_OnToggled">
                                    <ui:ToggleSwitch.Style>
                                        <Style TargetType="ui:ToggleSwitch">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbPauseOptions}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:ToggleSwitch.Style>
                                </ui:ToggleSwitch>
                                <TextBox
                                    x:Name="TxtbxCustompausetext"
                                    TextChanged="TxtbxCustompausetext_TextChanged"
                                    TextWrapping="Wrap">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbPauseOptions}" Value="1">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </ui:Card>

                        <!--  Options  -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_options}" />
                                <ui:ToggleSwitch
                                    x:Name="TglCanvas"
                                    Margin="0,0,0,12"
                                    d:Content="{x:Static local:Resources.window_settings_output_download_canvas}"
                                    Checked="TglCanvas_OnToggled"
                                    Content="{DynamicResource window_settings_output_download_canvas}"
                                    Focusable="False"
                                    Unchecked="TglCanvas_OnToggled" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_output_requester_prefix}" />
                                    <TextBox
                                        x:Name="TbRequesterPrefix"
                                        Width="180"
                                        HorizontalAlignment="Right"
                                        TextChanged="TbRequesterPrefix_TextChanged" />
                                </Grid>
                                <DockPanel LastChildFill="False">
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_copy_song_url}" />
                                    <Button
                                        x:Name="BtnCopyUrl"
                                        Width="32"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Click="BtnCopyURL_Click">
                                        <ui:SymbolIcon
                                            Width="16"
                                            Height="16"
                                            Symbol="Link24" />
                                    </Button>
                                </DockPanel>
                                <!--  Hidden / legacy  -->
                                <ui:ToggleSwitch
                                    x:Name="ChbxUpload"
                                    d:Content="{x:Static local:Resources.window_settings_output_upload_song_info}"
                                    Checked="ChbxUpload_Checked"
                                    Content="{DynamicResource window_settings_output_upload_song_info}"
                                    Focusable="False"
                                    Unchecked="ChbxUpload_Checked"
                                    Visibility="Collapsed" />
                                <ui:ToggleSwitch
                                    x:Name="ChbxSplit"
                                    d:Content="{x:Static local:Resources.window_settings_output_split_artist}"
                                    Checked="ChbxSplit_Checked"
                                    Content="{DynamicResource window_settings_output_split_artist}"
                                    Focusable="False"
                                    Unchecked="ChbxSplit_Checked"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                x:Name="TabItemTwitch"
                d:Header="{x:Static local:Resources.window_settings_tab_integration}"
                Header="{DynamicResource window_settings_tab_integration}"
                Tag="Twitch">
                <ScrollViewer Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" Margin="0,0,15,12">
                        <!--  Accounts  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_tab_accounts}" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_accounts_hint}"
                                    TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Main  -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_broadcaster}" />
                                        <DockPanel x:Name="PnlTwich" Margin="0,0,0,12">
                                            <Border
                                                Width="60"
                                                Height="60"
                                                VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                BorderThickness="3"
                                                ClipToBounds="True"
                                                CornerRadius="30">
                                                <Border.Background>
                                                    <ImageBrush
                                                        x:Name="ImgTwitchProfile"
                                                        ImageSource="/Resources/songify.ico"
                                                        Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label
                                                        x:Name="LblTwitchName"
                                                        Margin="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        d:Content="{x:Static local:Resources.window_settings_integration_twitch_account}"
                                                        Content="{DynamicResource window_settings_integration_twitch_account}"
                                                        Tag="main" />
                                                    <Button
                                                        x:Name="BtnTwitchLogout"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:ToolTip="{x:Static local:Resources.window_settings_twitch_logout}"
                                                        Click="BtnTwitchLogout_OnClick"
                                                        Tag="Main"
                                                        ToolTip="{DynamicResource window_settings_twitch_logout}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitch, Path=Visibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitch, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon
                                                            Width="15"
                                                            Height="15"
                                                            Symbol="SignOut24" />
                                                    </Button>
                                                    <Button
                                                        x:Name="BtnTwitchRefreshMain"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:ToolTip="{x:Static local:Resources.window_settings_twitch_refresh}"
                                                        Click="BtnLogInTwitch_Click"
                                                        Tag="Main"
                                                        ToolTip="{DynamicResource window_settings_twitch_refresh}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitch, Path=Visibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitch, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon
                                                            Width="16"
                                                            Height="16"
                                                            Symbol="ArrowSync24" />
                                                    </Button>
                                                </StackPanel>
                                                <Label
                                                    x:Name="LblMainExpiry"
                                                    Margin="0,2,0,0"
                                                    Padding="0"
                                                    Content="{DynamicResource window_settings_expires_on}"
                                                    FontSize="10" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnLogInTwitch"
                                                MinWidth="150"
                                                Margin="0,0,8,0"
                                                Click="BtnLogInTwitch_Click"
                                                Visibility="Visible">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center">
                                                        <Path
                                                            Data="{StaticResource IconTwitchGeometry}"
                                                            Fill="{StaticResource BrandTwitchBrush}"
                                                            Stretch="Uniform" />
                                                    </Viewbox>
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:Text="{x:Static local:Resources.menu_twitch_login}"
                                                        Text="{DynamicResource menu_twitch_login}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="BtnLogInTwitchAlt"
                                                Click="BtnLogInTwitchAlt_Click"
                                                Tag="main">
                                                <TextBlock d:Text="{x:Static local:Resources.menu_twitch_doesnt_work}" Text="{DynamicResource menu_twitch_doesnt_work}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Bot  -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource window_settings_bot}" />
                                        <DockPanel x:Name="PnlTwichBot" Margin="0,0,0,12">
                                            <Border
                                                Width="60"
                                                Height="60"
                                                VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                BorderThickness="3"
                                                ClipToBounds="True"
                                                CornerRadius="30">
                                                <Border.Background>
                                                    <ImageBrush
                                                        x:Name="ImgTwitchBotProfile"
                                                        ImageSource="/Resources/songify.ico"
                                                        Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Label
                                                        x:Name="LblTwitchBotName"
                                                        Margin="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        d:Content="{x:Static local:Resources.window_settings_twitch_bot}"
                                                        Content="{DynamicResource window_settings_twitch_bot}"
                                                        Tag="bot" />
                                                    <Button
                                                        x:Name="BtnTwitchBotLogout"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:ToolTip="{x:Static local:Resources.window_settings_twitch_logout}"
                                                        Click="BtnTwitchLogout_OnClick"
                                                        Tag="Bot"
                                                        ToolTip="{DynamicResource window_settings_twitch_logout}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitchBot, Path=Visibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitchBot, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon
                                                            Width="15"
                                                            Height="15"
                                                            Symbol="SignOut24" />
                                                    </Button>
                                                    <Button
                                                        x:Name="BtnTwitchRefreshBot"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:ToolTip="{x:Static local:Resources.window_settings_twitch_refresh}"
                                                        Click="BtnLogInTwitchBot_OnClick"
                                                        Tag="Bot"
                                                        ToolTip="{DynamicResource window_settings_twitch_refresh}">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitchBot, Path=Visibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ElementName=BtnLogInTwitchBot, Path=Visibility}" Value="Visible">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon
                                                            Width="16"
                                                            Height="16"
                                                            Symbol="ArrowSync24" />
                                                    </Button>
                                                </StackPanel>
                                                <Label
                                                    x:Name="LblBotExpiry"
                                                    Margin="0,2,0,0"
                                                    Padding="0"
                                                    Content="{DynamicResource window_settings_expires_on}"
                                                    FontSize="10" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnLogInTwitchBot"
                                                MinWidth="150"
                                                Margin="0,0,8,0"
                                                Click="BtnLogInTwitchBot_OnClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center">
                                                        <Path
                                                            Data="{StaticResource IconTwitchGeometry}"
                                                            Fill="{StaticResource BrandTwitchBrush}"
                                                            Stretch="Uniform" />
                                                    </Viewbox>
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        d:Text="{x:Static local:Resources.menu_twitch_login}"
                                                        Text="{DynamicResource menu_twitch_login}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="BtnLogInTwitchAltBot"
                                                Click="BtnLogInTwitchAlt_Click"
                                                Tag="bot">
                                                <TextBlock d:Text="{x:Static local:Resources.menu_twitch_doesnt_work}" Text="{DynamicResource menu_twitch_doesnt_work}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!--  Chat account  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_chat_account}" />
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_chat_account_hint}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    x:Name="CbAccountSelection"
                                    MinWidth="200"
                                    HorizontalAlignment="Left"
                                    SelectionChanged="CbAccountSelection_SelectionChanged" />
                            </StackPanel>
                        </ui:Card>

                        <!--  Manual credentials  -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <ui:ToggleSwitch
                                    x:Name="CheckShowCred"
                                    Margin="0,0,0,4"
                                    d:Content="{x:Static local:Resources.window_settings_integration_show_creds}"
                                    Content="{DynamicResource window_settings_integration_show_creds}"
                                    IsChecked="False" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_manual_oauth_hint}"
                                    TextWrapping="Wrap" />
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CheckShowCred, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_account_name}" />
                                        <TextBox
                                            x:Name="TxtbxTwUser"
                                            Width="280"
                                            HorizontalAlignment="Right"
                                            Text=""
                                            TextChanged="Txtbx_twUser_TextChanged"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_oauth_token}" />
                                        <Grid Width="280" HorizontalAlignment="Right">
                                            <PasswordBox
                                                x:Name="TxtbxTwOAuth"
                                                Margin="0,0,30,0"
                                                PasswordChanged="Txtbx_twOAuth_PasswordChanged" />
                                            <Button
                                                Width="27"
                                                HorizontalAlignment="Right"
                                                d:ToolTip="{x:Static local:Resources.window_settings_oauth_token_tooltip}"
                                                Click="Button_Click"
                                                Content="?"
                                                ToolTip="{DynamicResource window_settings_oauth_token_tooltip}" />
                                        </Grid>
                                    </Grid>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_channel_to_join}" />
                                        <TextBox
                                            x:Name="TxtbxTwChannel"
                                            Width="280"
                                            HorizontalAlignment="Right"
                                            TextChanged="Txtbx_twChannel_TextChanged"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!--  Connection &amp; chat  -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_connection_chat}" />
                                <ui:ToggleSwitch
                                    x:Name="ChbxTwAutoconnect"
                                    Margin="0,0,0,8"
                                    d:Content="{x:Static local:Resources.window_settings_integration_autoconnect}"
                                    Checked="Chbx_TwAutoconnect_Checked"
                                    Content="{DynamicResource window_settings_integration_autoconnect}"
                                    Unchecked="Chbx_TwAutoconnect_Checked" />
                                <ui:ToggleSwitch
                                    x:Name="TglAnnounceInChat"
                                    Margin="0,0,0,8"
                                    d:Content="{x:Static local:Resources.window_settings_integration_auto_announce}"
                                    Checked="Tgl_AnnounceInChat_Toggled"
                                    Content="{DynamicResource window_settings_integration_auto_announce}"
                                    Unchecked="Tgl_AnnounceInChat_Toggled" />
                                <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TglAnnounceInChat}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource window_settings_integration_min_msg_for_announce}" />
                                    <ui:NumberBox
                                        x:Name="Nb_MinimumMessagesBetweenAnnounces"
                                        MinWidth="130"
                                        HorizontalAlignment="Right"
                                        ClearButtonEnabled="False"
                                        Minimum="0"
                                        ValueChanged="MinimumMessagesBetweenAnnounces_ValueChanged" />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    x:Name="TglOnlyWorkWhenLive"
                                    Margin="0,0,0,8"
                                    Checked="Tgl_OnlyWorkWhenLive_OnToggled"
                                    Unchecked="Tgl_OnlyWorkWhenLive_OnToggled">
                                    <ui:ToggleSwitch.Content>
                                        <TextBlock
                                            d:Text="{x:Static local:Resources.window_settings_integration_only_when_live}"
                                            Text="{DynamicResource window_settings_integration_only_when_live}"
                                            TextWrapping="Wrap" />
                                    </ui:ToggleSwitch.Content>
                                </ui:ToggleSwitch>
                                <ui:ToggleSwitch
                                    x:Name="TglInformChat"
                                    Margin="0,0,0,8"
                                    d:ToolTip="{x:Static local:Resources.window_settings_offline_cancelled_tooltip}"
                                    Checked="Tgl_InformChat_Toggled"
                                    ToolTip="{DynamicResource window_settings_offline_cancelled_tooltip}"
                                    Unchecked="Tgl_InformChat_Toggled">
                                    <ui:ToggleSwitch.Content>
                                        <TextBlock
                                            d:Text="{x:Static local:Resources.window_settings_integration_stream_not_live_notification}"
                                            Text="{DynamicResource window_settings_integration_stream_not_live_notification}"
                                            TextWrapping="Wrap" />
                                    </ui:ToggleSwitch.Content>
                                </ui:ToggleSwitch>
                                <ui:ToggleSwitch
                                    x:Name="TglSharedChat"
                                    d:ToolTip="{x:Static local:Resources.window_settings_shared_chat_tooltip}"
                                    Checked="Tgl_SharedChat_Toggled"
                                    ToolTip="{DynamicResource window_settings_shared_chat_tooltip}"
                                    Unchecked="Tgl_SharedChat_Toggled">
                                    <ui:ToggleSwitch.Content>
                                        <TextBlock
                                            d:Text="{x:Static local:Resources.window_settings_integration_stream_shared_chat}"
                                            Text="{DynamicResource window_settings_integration_stream_shared_chat}"
                                            TextWrapping="Wrap" />
                                    </ui:ToggleSwitch.Content>
                                </ui:ToggleSwitch>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                x:Name="TabItemTwitchReward"
                Padding="20,0,0,0"
                d:Header="{x:Static local:Resources.window_settings_tab_rewards}"
                Header="{DynamicResource window_settings_tab_rewards}"
                Tag="TwitchRewards">
                <Border Padding="4,0,0,0" Background="Transparent">
                    <Grid x:Name="GrdTwitchReward" Margin="10,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,6"
                            VerticalAlignment="Top"
                            d:Text="{x:Static local:Resources.window_settings_spotify_reward_sr}"
                            Text="{DynamicResource window_settings_spotify_reward_sr}" />
                        <Button
                            x:Name="BtnCreateNewReward"
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="32"
                            Margin="0,0,38,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            d:ToolTip="{x:Static local:Resources.window_settings_twitch_create_reward}"
                            Click="BtnCreateNewReward_Click"
                            IsEnabled="False"
                            ToolTip="{DynamicResource window_settings_twitch_create_reward}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Symbol="Add24" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource window_settings_create_new_reward}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button
                            x:Name="BtnUpdateRewards"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="0,0,0,0"
                            Padding="0,5,0,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            d:ToolTip="{x:Static local:Resources.window_settings_reload_rewards_tooltip}"
                            Click="BtnUpdateRewards_Click"
                            ToolTip="{DynamicResource window_settings_reload_rewards_tooltip}">
                            <Button.Content>
                                <ui:SymbolIcon
                                    Width="16"
                                    Height="16"
                                    Symbol="ArrowSync24" />
                            </Button.Content>
                        </Button>
                        <ui:ToggleSwitch
                            x:Name="TglOnlySkipNonSrRewards"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,10"
                            d:Content="{x:Static local:Resources.window_settings_twitch_disable_skip_for_requests}"
                            Checked="TglOnlySkipNonSrRewards_OnToggled"
                            Content="{DynamicResource window_settings_twitch_disable_skip_for_requests}"
                            Unchecked="TglOnlySkipNonSrRewards_OnToggled" />

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,10"
                            Padding="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    x:Name="BtnRewardsSegmentChannel"
                                    MinWidth="140"
                                    Margin="0,0,4,0"
                                    Appearance="Primary"
                                    Click="BtnRewardsSegmentChannel_Click"
                                    Content="{DynamicResource window_settings_tab_channel_rewards}" />
                                <ui:Button
                                    x:Name="BtnRewardsSegmentRefund"
                                    MinWidth="140"
                                    Appearance="Secondary"
                                    Click="BtnRewardsSegmentRefund_Click"
                                    Content="{DynamicResource window_settings_tab_refund_conditions}" />
                            </StackPanel>
                        </Border>

                        <Grid
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <ListBox
                                x:Name="ListboxRewards"
                                Margin="0,0,0,0"
                                IsEnabled="True"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Single"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingStackPanel.ScrollUnit="Item">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type userControls:TwitchRewardListItem}">
                                        <userControls:UcTwitchReward />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <StackPanel
                                x:Name="PnlRefundConditions"
                                Orientation="Vertical"
                                Visibility="Collapsed">
                                <TextBlock Margin="0,0,0,6" Text="{DynamicResource window_settings_refund_conditions_info}" />
                                <Grid
                                    x:Name="RefundSwitchesPanel"
                                    VerticalAlignment="Top"
                                    SizeChanged="RefundSwitchesPanel_OnSizeChanged" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem
                x:Name="TabItemTwitchPoll"
                Padding="20,0,0,0"
                d:Header="{x:Static local:Resources.window_settings_tab_polls}"
                Header="{DynamicResource window_settings_tab_polls}"
                Tag="TwitchPolls">
                <ScrollViewer Padding="0,0,15,0">
                    <StackPanel
                        x:Name="GrdTwitchPoll"
                        MaxWidth="720"
                        Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource window_settings_poll_setup_hint}"
                            TextWrapping="Wrap" />

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource window_settings_poll_content}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_poll_title}" />
                                <TextBox
                                    x:Name="TextBoxPollTitle"
                                    Margin="0,0,0,12"
                                    TextChanged="TextBoxPollTitle_OnTextChanged" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_answer_1}" />
                                <TextBox
                                    x:Name="TextBoxPollAnswer1"
                                    Margin="0,0,0,12"
                                    TextChanged="TextBoxPollAnswer1_OnTextChanged" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource window_settings_answer_2}" />
                                <TextBox x:Name="TextBoxPollAnswer2" TextChanged="TextBoxPollAnswer2_OnTextChanged" />
