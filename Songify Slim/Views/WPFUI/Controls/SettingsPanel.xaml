                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                d:Header="{x:Static local:Resources.window_settings_tab_webserver}"
                Header="{DynamicResource window_settings_tab_webserver}"
                Tag="WebServer">
                <ScrollViewer Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" Margin="0,0,0,12">
                        <TextBlock
                            x:Name="TbWebServerAdminWarning"
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Text="{DynamicResource window_settings_webserver_admin_lan_hint}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_server}" />
                                <Grid Margin="0,0,0,12">
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_webserver_port}" />
                                    <ui:NumberBox
                                        x:Name="NudServerPort"
                                        Width="100"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ClearButtonEnabled="False"
                                        Maximum="66535"
                                        Minimum="1025"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NudServerPort_ValueChanged" />
                                </Grid>
                                <ui:ToggleSwitch
                                    x:Name="TglAutoStartWebserver"
                                    Margin="0,0,0,12"
                                    d:Content="{x:Static local:Resources.window_settings_webserver_auto_start}"
                                    Checked="TglAutoStartWebserver_Toggled"
                                    Content="{DynamicResource window_settings_webserver_auto_start}"
                                    Unchecked="TglAutoStartWebserver_Toggled" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnWebserverStart"
                                        Margin="0,0,8,0"
                                        d:Content="{x:Static local:Resources.window_settings_webserver_start}"
                                        Click="BtnWebserverStart_Click"
                                        Content="{DynamicResource window_settings_webserver_start}" />
                                    <Button
                                        x:Name="BtnWebserverOpenUrl"
                                        d:Content="{x:Static local:Resources.window_settings_webserver_open_website}"
                                        Click="BtnWebserverOpenUrl_OnClick"
                                        Content="{DynamicResource window_settings_webserver_open_website}"
                                        ToolTip="{DynamicResource window_settings_webserver_urls_tooltip}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_security}" />
                                <ui:ToggleSwitch
                                    x:Name="TglWebServerPassword"
                                    Margin="0,0,0,12"
                                    Checked="TglWebServerPassword_Toggled"
                                    Content="{DynamicResource window_settings_require_websocket_password}"
                                    ToolTip="{DynamicResource window_settings_require_websocket_password_tooltip}"
                                    Unchecked="TglWebServerPassword_Toggled" />
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_websocket_password}" />
                                    <PasswordBox
                                        x:Name="PasswordBox_WebServer"
                                        Width="280"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        PasswordChanged="PasswordBox_WebServer_OnPasswordChanged" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                d:Header="{x:Static local:Resources.window_settings_tab_config}"
                Header="{DynamicResource window_settings_tab_config}"
                Tag="Config">
                <ScrollViewer Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" Margin="0,0,15,12">
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    d:Text="{x:Static local:Resources.window_settings_section_backup}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_section_backup}" />
                                <WrapPanel>
                                    <Button
                                        x:Name="BtnExportConfig"
                                        MinWidth="140"
                                        Margin="0,0,8,8"
                                        d:Content="{x:Static local:Resources.window_settings_config_export}"
                                        Click="Btn_ExportConfig_Click"
                                        Content="{DynamicResource window_settings_config_export}" />
                                    <Button
                                        x:Name="BtnImportConfig"
                                        MinWidth="140"
                                        Margin="0,0,8,8"
                                        d:Content="{x:Static local:Resources.window_settings_config_import}"
                                        Click="Btn_ImportConfig_Click"
                                        Content="{DynamicResource window_settings_config_import}" />
                                    <Button
                                        x:Name="BtnResetConfig"
                                        MinWidth="140"
                                        Margin="0,0,0,8"
                                        d:Content="{x:Static local:Resources.window_settings_config_reset}"
                                        Click="Btn_ResetConfig_Click"
                                        Content="{DynamicResource window_settings_config_reset}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    d:Text="{x:Static local:Resources.window_settings_section_cloud}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_section_cloud}" />
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Opacity="0.85"
                                    Text="{DynamicResource window_settings_cloud_premium_hint}"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnSaveCloudSettings"
                                        Margin="0,0,8,0"
                                        Click="BtnSaveCloudSettings_OnClick">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Width="16"
                                                    Height="16"
                                                    Symbol="ArrowUpload24" />
                                                <TextBlock
                                                    Margin="6,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource window_settings_save_cloud}" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="BtnRestoreCloudSettings" Click="BtnRestoreCloudSettings_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Width="16"
                                                Height="16"
                                                Symbol="ArrowDownload24" />
                                            <TextBlock
                                                Margin="6,0"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource window_settings_restore_cloud}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TblError"
                                    Margin="0,0,0,6"
                                    Foreground="Red" />
                                <TextBlock
                                    Opacity="0.85"
                                    Text="{DynamicResource window_settings_credentials_disclaimer}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
