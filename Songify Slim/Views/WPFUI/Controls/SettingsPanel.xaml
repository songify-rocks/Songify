                                            DisplayMemberPath="Display"
                                            SelectedValuePath="Header"
                                            SelectionChanged="CbxArtistBlocklistSyncColumn_OnSelectionChanged" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        Height="36"
                                        MinWidth="110"
                                        Margin="12,21,0,0"
                                        VerticalAlignment="Center"
