                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_section_auth_ports}" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_redirect_port}" />
                                    <ComboBox
                                        x:Name="ComboboxRedirectPort"
                                        MinWidth="120"
                                        HorizontalAlignment="Right"
                                        SelectionChanged="ComboboxRedirectPort_SelectionChanged" />
                                </Grid>
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource window_settings_fetch_port}" />
                                    <ComboBox
                                        x:Name="ComboboxfetchPort"
                                        MinWidth="120"
                                        HorizontalAlignment="Right"
                                        SelectionChanged="ComboboxfetchPort_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card
                            x:Name="CardSongifyApiToken"
                            Margin="0,0,0,12"
                            Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    d:Text="{x:Static local:Resources.window_settings_songify_api_token}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_songify_api_token}" />
                                <TextBlock
                                    x:Name="TblSongifyTokenHelp"
                                    Margin="0,0,0,12"
                                    Opacity="0.85"
                                    Text="{DynamicResource window_settings_songify_api_token_help}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TblSongifyTokenStatus"
                                    Margin="0,0,0,12"
                                    TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <PasswordBox
                                            x:Name="PasswordBox"
                                            Padding="0,0,30,0"
                                            VerticalContentAlignment="Center"
                                            PasswordChanged="PasswordBox_OnPasswordChanged" />
                                        <TextBox
                                            x:Name="TextBox"
                                            Padding="0,0,30,0"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="TextBox_OnTextChanged"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="ShowHideButton"
                                            Width="24"
                                            MinWidth="0"
                                            Margin="0,0,3,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Click="ShowHideButton_OnClick">
                                            <ui:SymbolIcon
                                                x:Name="EyeIcon"
                                                Width="16"
                                                Height="16"
                                                Symbol="EyeOff24" />
                                        </Button>
                                    </Grid>
                                    <Button
                                        x:Name="BtnGetSongifyToken"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Click="BtnGetSongifyToken_OnClick"
                                        Content="{DynamicResource setup_token_get}" />
                                    <Button
                                        x:Name="BtnRefreshPremium"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        MinWidth="32"
                                        Margin="0,0,8,0"
                                        Padding="0"
                                        Click="BtnRefreshPremium_OnClick"
                                        ToolTip="{DynamicResource setup_token_refresh_premium}">
                                        <ui:SymbolIcon
                                            Width="16"
                                            Height="16"
                                            Symbol="ArrowSync24" />
                                    </Button>
                                    <Button
                                        x:Name="btnApiToken"
                                        Grid.Column="3"
                                        Width="32"
                                        d:Content="{x:Static local:Resources.common_help}"
                                        Click="BtnApiToken_OnClick"
                                        Content="{DynamicResource common_help}" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    d:Text="{x:Static local:Resources.window_settings_section_advanced}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource window_settings_section_advanced}" />
                                <ui:ToggleSwitch
                                    x:Name="TglDebugLogging"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch"
                                    d:Content="{x:Static local:Resources.window_settings_enable_debug_logging}"
                                    Checked="TglDebugLogging_OnToggled"
                                    Content="{DynamicResource window_settings_enable_debug_logging}"
                                    TabIndex="8"
                                    Unchecked="TglDebugLogging_OnToggled" />
                                <DockPanel LastChildFill="False">
                                    <TextBlock
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource window_settings_keep_last_log_files}"
                                        ToolTip="{DynamicResource window_settings_keep_last_log_files_tooltip}" />
                                    <ui:NumberBox
                                        x:Name="NudLogFileRetention"
                                        Width="70"
                                        VerticalAlignment="Center"
                                        ClearButtonEnabled="False"
                                        Maximum="365"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        ValueChanged="NudLogFileRetention_ValueChanged" />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>