                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource window_settings_tab_youtube}" Tag="Youtube">
                <ScrollViewer Padding="0,0,4,0">
                    <StackPanel MaxWidth="720" Margin="0,0,15,12">
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource window_settings_youtube_api_key}" />
