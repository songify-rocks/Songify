<UserControl
    x:Class="Songify_Slim.Views.WPFUI.Controls.ConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    VerticalAlignment="Stretch">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="0,0,0,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,12,0"
                Appearance="Secondary"
                Click="BtnClearConsole_Click"
                Content="{DynamicResource window_console_clear}"
                Icon="{ui:SymbolIcon Delete24}" />
            <ui:Button
                Appearance="Secondary"
                Click="BtnRefreshMetrics_Click"
                Content="{DynamicResource window_console_refresh_metrics}"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </StackPanel>

        <TabControl
            Grid.Row="1"
            MinHeight="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <TabItem
                MinWidth="75"
                VerticalAlignment="Stretch"
                Header="{DynamicResource window_console_log}">
                <Grid MinHeight="0" VerticalAlignment="Stretch">
                    <RichTextBox
                        x:Name="RtbConsole"
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#252525"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="White"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextChanged="RtbConsole_TextChanged" />
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource window_console_api_metrics}">
                <DataGrid
                    MinHeight="0"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Rows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Key}"
                            Header="{DynamicResource window_console_endpoint}" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding RequestsPerMinute}"
                            Header="{DynamicResource window_console_requests_per_min}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource window_console_graph}">
                <Grid
                    MinHeight="0"
                    Margin="12"
                    VerticalAlignment="Stretch">
                    <ContentControl
                        x:Name="ApiChartHost"
                        MinHeight="0"
                        VerticalAlignment="Stretch" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
