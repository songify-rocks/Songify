<Page
    x:Class="Songify_Slim.Views.WPFUI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:util="clr-namespace:Songify_Slim.Util"
    Title="{DynamicResource window_history_title}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <util:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="HistoryDayButtonStyle" TargetType="CalendarDayButton">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Grid>
                                <Border
                                    x:Name="Bg"
                                    Margin="1"
                                    Background="Transparent"
                                    CornerRadius="6" />
                                <ContentPresenter
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                                <Ellipse
                                    x:Name="Dot"
                                    Width="5"
                                    Height="5"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="Dot" Property="Fill" Value="White" />
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                                </Trigger>
                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter Property="Opacity" Value="0.28" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="Loaded" Handler="HistoryDayButton_Loaded" />
            </Style>
            <ContextMenu x:Key="HistoryDeleteDayMenu" x:Shared="false">
                <MenuItem Click="DeleteDayMenuItem_Click" Header="{DynamicResource window_history_delete_day}" />
            </ContextMenu>
            <Style x:Key="HistorySongItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Bd"
                                Margin="0,0,16,0"
                                Padding="12,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20,16" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!--  Header + options  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="TxtTitle"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource window_history_title}" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:ToggleSwitch
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource window_history_save_locally}"
                    IsChecked="{Binding SaveHistory, Mode=TwoWay}"
                    ToolTip="{DynamicResource window_history_save_tooltip}" />
                <ui:Button
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Click="BtnRecap_Click"
                    Content="{DynamicResource window_history_open_recap}"
                    ToolTip="{DynamicResource window_history_open_recap_tooltip}" />
                <ui:Button
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="{DynamicResource common_refresh}"
                    ToolTip="{DynamicResource window_history_refresh_tooltip}" />
            </StackPanel>
        </Grid>

        <!--  Calendar | songs  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ui:Card
                Grid.Column="0"
                Width="312"
                Margin="0,0,12,0"
                Padding="12"
                VerticalAlignment="Stretch">
                <ScrollViewer>
                    <Grid Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Calendar
                            x:Name="HistoryCalendar"
                            Grid.Row="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            CalendarDayButtonStyle="{StaticResource HistoryDayButtonStyle}"
                            DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                            DisplayDateChanged="HistoryCalendar_DisplayDateChanged"
                            DisplayDateEnd="{Binding DisplayDateEnd, Mode=OneWay}"
                            DisplayDateStart="{Binding DisplayDateStart, Mode=OneWay}"
                            DisplayMode="Month"
                            SelectedDate="{Binding CalendarSelectedDate, Mode=TwoWay}"
                            SelectionMode="SingleDate" />

                        <TextBlock
                            Grid.Row="0"
                            Margin="4,24,4,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource window_history_empty}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasDates, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                        <!--<Border
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding HasDates, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SelectedDateTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding SelectedDate.CountLabel}" />
                        </StackPanel>
                    </Border>-->
                    </Grid>
                </ScrollViewer>

            </ui:Card>

            <ui:Card
                Grid.Column="1"
                Padding="12"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                    <ListBox
                        x:Name="DgvHistorySongs"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource HistorySongItemStyle}"
                        ItemsSource="{Binding Songs}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
                        Visibility="{Binding HasSongs, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding DeleteSongCommand}" Header="{DynamicResource window_history_delete_song}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Time}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Artist}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource window_history_no_songs}"
                        Visibility="{Binding HasNoSongs, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
