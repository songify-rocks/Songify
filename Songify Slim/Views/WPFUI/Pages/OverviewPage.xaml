<Page
    x:Class="Songify_Slim.Views.WPFUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource nav_home}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="800"
            Margin="24"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource nav_home}" />
                <ComboBox
                    x:Name="CbxPlayer"
                    Grid.Column="1"
                    MinWidth="190"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    SelectionChanged="CbxPlayer_SelectionChanged" />
            </Grid>

            <!--  Now playing: compact card, no stretched empty space  -->
            <ui:Card
                Grid.Row="1"
                Margin="0,0,0,16"
                Padding="16"
                HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,0">
                        <ui:Image
                            x:Name="ImgCover"
                            MaxWidth="120"
                            MaxHeight="120"
                            CornerRadius="12"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Stretch="UniformToFill" />
                        <ui:Card
                            x:Name="CoverPlaceholder"
                            Width="120"
                            Height="120"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="Visible">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource window_queue_no_art}" />
                        </ui:Card>
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TxtNowPlaying"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource window_overview_nothing_playing}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TxtArtist"
                            FontSize="18"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text=""
                            TextWrapping="Wrap" />
                        <Grid x:Name="PlayingStatePanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="TxtElapsed"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="" />
                            <ProgressBar
                                x:Name="TrackProgressBar"
                                Grid.Column="1"
                                Height="6"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                Visibility="Collapsed"
                                Value="0" />
                            <TextBlock
                                x:Name="TxtDuration"
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!--  Up next (next 3 from playback queue)  -->
            <ui:Card
                Grid.Row="2"
                Margin="0,0,0,16"
                Padding="14"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource window_overview_up_next}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            DockPanel.Dock="Right"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            MouseLeftButtonUp="UpNextCard_MouseLeftButtonUp"
                            Text="{DynamicResource window_overview_open_queue}" />
                    </DockPanel>
                    <ItemsControl x:Name="UpNextList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                    <Border
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        ClipToBounds="True"
                                        CornerRadius="8">
                                        <ui:Image
                                            CornerRadius="8"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding CoverUrl}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Position, StringFormat='#{0}'}"
                                            TextWrapping="WrapWithOverflow"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            MaxWidth="150"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            MaxWidth="140"
                                            HorizontalAlignment="Left"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="TxtUpNextEmpty"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource window_overview_nothing_queued}"
                        Visibility="Collapsed" />
                </StackPanel>
            </ui:Card>

            <ui:Button
                x:Name="BtnSupport"
                Grid.Row="3"
                Padding="10,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Appearance="Secondary"
                Click="BtnSupport_Click"
                Content="{DynamicResource menu_support}" />

            <!--  Kept for code-behind / localization hooks  -->
            <!--<ui:Button
                x:Name="BtnSettings"
                Click="BtnSettings_Click"
                Visibility="Collapsed" />
            <ui:Button
                x:Name="BtnQueue"
                Click="BtnQueue_Click"
                Visibility="Collapsed" />
            <ui:Button
                x:Name="BtnTwitchConnect"
                Click="BtnTwitchConnect_Click"
                Visibility="Collapsed" />-->
        </Grid>
    </ScrollViewer>
</Page>