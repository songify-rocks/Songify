<Page
    x:Class="Songify_Slim.Views.WPFUI.Pages.BlacklistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:util="clr-namespace:Songify_Slim.Util"
    xmlns:viewModels="clr-namespace:Songify_Slim.Views.WPFUI.ViewModels"
    Title="{DynamicResource window_blocklist_title}"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.PanningMode="None"
    ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Page.Resources>
        <util:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="BlocklistCategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="10,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Page.DataContext>
        <viewModels:BlocklistViewModel />
    </Page.DataContext>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource window_blocklist_title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource window_blocklist_subtitle}" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="{DynamicResource common_loading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!--
            NavigationView hosts pages inside a ScrollViewer. If the ListBox measures with infinite height,
            virtualization dies and WPF creates a visual for every artist (~6k) — that freezes the PC.
            Page ScrollViewer.* = Disabled (above) + list in a * row with its own scrollbar keeps height finite.
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <ui:Card
                Grid.Column="0"
                Margin="0,0,12,0"
                Padding="10"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="2,0,0,10"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_blocklist_categories}" />
                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource BlocklistCategoryItemStyle}"
                        ItemsSource="{Binding Categories}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <ui:SymbolIcon
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Symbol="{Binding Symbol}" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Loaded="CategoryTitle_Loaded" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding CountLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <ui:Card
                Grid.Column="1"
                Padding="14"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding SelectedCategoryTitle}" />

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Margin="0,0,12,0"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{DynamicResource window_blocklist_search_list}"
                            Text="{Binding ListFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="{Binding ListStatusText}" />
                    </Grid>

                    <!--  Artists  -->
                    <Grid Grid.Row="2" Visibility="{Binding IsArtistsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" PreviewKeyDown="ArtistInput_OnPreviewKeyDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="TbNewArtist"
                                Margin="0,0,12,0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="{DynamicResource window_blocklist_search_artist_placeholder}"
                                Text="{Binding NewArtistName, UpdateSourceTrigger=PropertyChanged}" />
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsArtistSuggestionsOpen, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=TbNewArtist}"
                                StaysOpen="False">
                                <Border
                                    MinWidth="280"
                                    MaxHeight="280"
                                    Padding="4"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ListBox
                                        x:Name="LbArtistSuggestions"
                                        DisplayMemberPath="Artist"
                                        ItemsSource="{Binding ArtistSuggestions}"
                                        MouseLeftButtonUp="ArtistSuggestion_OnMouseLeftButtonUp"
                                        SelectedItem="{Binding SelectedArtistSuggestion, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding AddArtistCommand}"
                                Content="{DynamicResource common_add}"
                                Icon="{ui:SymbolIcon Add24}" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding VisibleArtists}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedArtist}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Click="BtnImportArtists_OnClick"
                                Content="{DynamicResource common_import}"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Click="BtnRefreshArtistIds_OnClick"
                                Content="{DynamicResource window_blocklist_refresh_ids}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding RemoveSelectedArtistCommand}"
                                Content="{DynamicResource common_remove_selected}"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding ClearArtistsCommand}"
                                Content="{DynamicResource window_blocklist_clear_artists}"
                                Icon="{ui:SymbolIcon Delete24}" />
                        </StackPanel>
                    </Grid>

                    <!--  Users  -->
                    <Grid Grid.Row="2" Visibility="{Binding IsUsersSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Margin="0,0,12,0"
                                Icon="{ui:SymbolIcon Person28}"
                                PlaceholderText="{DynamicResource window_blocklist_add_username}"
                                Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding AddUserCommand}"
                                Content="{DynamicResource common_add}"
                                Icon="{ui:SymbolIcon Add24}" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding VisibleUsers}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedUser}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding RemoveSelectedUserCommand}"
                                Content="{DynamicResource common_remove_selected}"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding ClearUsersCommand}"
                                Content="{DynamicResource window_blocklist_clear_users}"
                                Icon="{ui:SymbolIcon Delete24}" />
                        </StackPanel>
                    </Grid>

                    <!--  Songs  -->
                    <Grid Grid.Row="2" Visibility="{Binding IsSongsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" PreviewKeyDown="SongInput_OnPreviewKeyDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                x:Name="TbNewSong"
                                Margin="0,0,12,0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="{DynamicResource window_blocklist_search_song_placeholder}"
                                Text="{Binding NewSongQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsSongSuggestionsOpen, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=TbNewSong}"
                                StaysOpen="False">
                                <Border
                                    MinWidth="320"
                                    MaxHeight="280"
                                    Padding="4"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ListBox
                                        x:Name="LbSongSuggestions"
                                        DisplayMemberPath="Display"
                                        ItemsSource="{Binding SongSuggestions}"
                                        MouseLeftButtonUp="SongSuggestion_OnMouseLeftButtonUp"
                                        SelectedItem="{Binding SelectedSongSuggestion, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding AddSongCommand}"
                                Content="{DynamicResource common_add}"
                                Icon="{ui:SymbolIcon Add24}" />
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding VisibleSongs}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedSong}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Secondary"
                                Command="{Binding RemoveSelectedSongCommand}"
                                Content="{DynamicResource common_remove_selected}"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding ClearSongsCommand}"
                                Content="{DynamicResource window_blocklist_clear_songs}"
                                Icon="{ui:SymbolIcon Delete24}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>

        <!--  Spotify artist picker (multiple matches)  -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#AA000000"
            Focusable="True"
            KeyDown="ArtistPickerOverlay_OnKeyDown"
            Visibility="{Binding IsArtistPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                MaxWidth="560"
                MaxHeight="420"
                Margin="24"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource window_blocklist_select_artist}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Opacity="0.75"
                        Text="{DynamicResource window_blocklist_multiple_artists_match}" />
                    <DataGrid
                        x:Name="ArtistPickerGrid"
                        Grid.Row="2"
                        Margin="0,10,0,10"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ArtistPickerItems}"
                        MouseDoubleClick="ArtistPickerGrid_OnMouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="ArtistPickerGrid_OnSelectionChanged"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Num}"
                                Header="{DynamicResource common_column_number}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Artist}"
                                Header="{DynamicResource common_artist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            MinWidth="100"
                            Margin="0,0,10,0"
                            Appearance="Secondary"
                            Command="{Binding CancelArtistPickCommand}"
                            Content="{DynamicResource common_close}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <ui:Button
                            MinWidth="140"
                            Appearance="Primary"
                            Command="{Binding ConfirmArtistPickCommand}"
                            Content="{DynamicResource window_blocklist_block_selected}"
                            Icon="{ui:SymbolIcon ShieldDismiss24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!--  Spotify song picker (multiple matches)  -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            Background="#AA000000"
            Focusable="True"
            KeyDown="SongPickerOverlay_OnKeyDown"
            Visibility="{Binding IsSongPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                MaxWidth="640"
                MaxHeight="420"
                Margin="24"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource window_blocklist_select_song}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Opacity="0.75"
                        Text="{DynamicResource window_blocklist_multiple_songs_match}" />
                    <DataGrid
                        x:Name="SongPickerGrid"
                        Grid.Row="2"
                        Margin="0,10,0,10"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding SongPickerItems}"
                        MouseDoubleClick="SongPickerGrid_OnMouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="SongPickerGrid_OnSelectionChanged"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Num}"
                                Header="{DynamicResource common_column_number}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Artist}"
                                Header="{DynamicResource common_artist}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Title}"
                                Header="{DynamicResource common_title}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            MinWidth="100"
                            Margin="0,0,10,0"
                            Appearance="Secondary"
                            Command="{Binding CancelSongPickCommand}"
                            Content="{DynamicResource common_close}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <ui:Button
                            MinWidth="140"
                            Appearance="Primary"
                            Command="{Binding ConfirmSongPickCommand}"
                            Content="{DynamicResource window_blocklist_block_selected}"
                            Icon="{ui:SymbolIcon ShieldDismiss24}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Page>
