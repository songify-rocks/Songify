<ui:FluentWindow
    x:Class="Songify_Slim.Views.WPFUI.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Songify_Slim.Views.WPFUI.Pages"
    xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:util="clr-namespace:Songify_Slim.Util"
    Width="900"
    Height="500"
    MinWidth="900"
    MinHeight="500"
    Closing="ShellWindow_Closing"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Resources/songify.ico"
    Loaded="ShellWindow_Loaded"
    WindowBackdropType="Mica"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <util:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="ShellTitleBar" CloseClicked="TitleBar_OnCloseClicked">
            <!--  Custom header: TitleBar.Icon/ImageIcon often clips .ico assets  -->
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        x:Name="TitleBarLogo"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/Resources/songify.ico"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Songify" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0,0,4,0" Orientation="Horizontal">


                    <ui:DropDownButton
                        MinWidth="72"
                        Margin="0,0,4,0"
                        Padding="12,6"
                        Appearance="Transparent"
                        Content="{DynamicResource menu_tools}"
                        FontSize="13">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Click="MenuWidget_OnClick" Header="{DynamicResource menu_file_widget}" />
                                <MenuItem Click="MenuWebServerUrl_OnClick" Header="{DynamicResource menu_view_webserver_url}" />
                                <MenuItem Click="MenuQueueBrowser_OnClick" Header="{DynamicResource menu_song_requests_queue_browser}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton
                        MinWidth="72"
                        Margin="0,0,4,0"
                        Padding="12,6"
                        Appearance="Transparent"
                        Content="{DynamicResource menu_twitch}"
                        FontSize="13">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Click="MenuTwitchLogin_OnClick" Header="{DynamicResource menu_twitch_login}" />
                                <MenuItem
                                    x:Name="MiTwitchConnect"
                                    Click="MenuTwitchConnect_OnClick"
                                    Header="{DynamicResource menu_twitch_connect}" />
                                <MenuItem
                                    x:Name="MiTwitchCheckOnlineStatus"
                                    Click="MenuTwitchOnline_OnClick"
                                    Header="{DynamicResource menu_twitch_check_online_status}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton
                        MinWidth="72"
                        Padding="12,6"
                        Appearance="Transparent"
                        Content="{DynamicResource menu_file_help}"
                        FontSize="13">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu x:Name="HelpContextMenu">
                                <MenuItem Click="MenuPatchNotes_OnClick" Header="{DynamicResource menu_file_patchnotes}" />
                                <MenuItem Click="MenuFaq_OnClick" Header="{DynamicResource menu_faq}" />
                                <MenuItem Click="MenuGitHub_OnClick" Header="{DynamicResource menu_github}" />
                                <MenuItem Click="MenuDiscord_OnClick" Header="{DynamicResource menu_discord}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14">
                                            <Path
                                                Data="{StaticResource IconDiscordGeometry}"
                                                Fill="{StaticResource BrandDiscordBrush}"
                                                Stretch="Uniform" />
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Click="MenuLogFolder_OnClick" Header="{DynamicResource menu_help_log_folder}" />
                                <MenuItem Click="MenuAppFolder_OnClick" Header="{DynamicResource menu_help_app_folder}" />
                                <MenuItem Click="MenuCheckUpdates_OnClick" Header="{DynamicResource menu_check_for_updates}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <Grid
                        Width="36"
                        Height="32"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <ui:Button
                            x:Name="BtnPsa"
                            Padding="6"
                            Appearance="Transparent"
                            Click="BtnPsa_OnClick"
                            ToolTip="{DynamicResource menu_notifications}">
                            <ui:SymbolIcon
                                x:Name="PsaBadgeIcon"
                                Width="16"
                                Height="16"
                                Symbol="Alert24" />
                        </ui:Button>
                        <Border
                            x:Name="PsaBadgePill"
                            Height="16"
                            MinWidth="16"
                            Margin="0,-2,-2,0"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="IndianRed"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PsaBadgeText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="0" />
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Persistent Spotify API / rate-limit banner  -->
        <Border
            x:Name="BrdSpotifyPersistentIssue"
            Grid.Row="1"
            Margin="12,0,12,8"
            Padding="12,10"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="#CD5C5C"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueTitle"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueBody"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbSpotifyPersistentIssueEta"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                    <Expander
                        x:Name="ExpSpotifyPersistentIssues"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Header="{DynamicResource menu_more}"
                        IsExpanded="False"
                        Visibility="Collapsed">
                        <ScrollViewer MaxHeight="140">
                            <StackPanel x:Name="PnlSpotifyPersistentIssues" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Click="BtnSpotifyPersistentIssueDismiss_Click"
                    Content="×"
                    FontSize="16"
                    ToolTip="{DynamicResource common_dismiss}" />
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigationView"
            Grid.Row="2"
            ClipToBounds="True"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            OpenPaneLength="150"
            PaneDisplayMode="LeftMinimal"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.PanningMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ui:NavigationView.Resources>
                <Style x:Key="NavSymbolIconStyle" TargetType="ui:SymbolIcon">
                    <Setter Property="Filled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=ui:NavigationViewItem}}" Value="True">
                            <Setter Property="Filled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:NavigationView.Resources>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource nav_home}"
                    TargetPageTag="overview"
                    TargetPageType="{x:Type pages:OverviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="Home48" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="{DynamicResource menu_queue}"
                    TargetPageTag="queue"
                    TargetPageType="{x:Type pages:QueuePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="List28" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource window_blocklist_title}"
                    TargetPageTag="blacklist"
                    TargetPageType="{x:Type pages:BlacklistPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="ShieldDismiss24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="{DynamicResource menu_history}"
                    TargetPageTag="history"
                    TargetPageType="{x:Type pages:HistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="History48" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="{DynamicResource window_userlist_title}"
                    TargetPageTag="userlist"
                    TargetPageType="{x:Type pages:UserListPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="People48" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource menu_file_settings}"
                    TargetPageTag="settings"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="Settings48" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="{DynamicResource menu_view_console}"
                    TargetPageTag="console"
                    TargetPageType="{x:Type pages:ConsolePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="CodeBlock28" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="{DynamicResource menu_help_about}"
                    TargetPageTag="about"
                    TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Style="{StaticResource NavSymbolIconStyle}" Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--  PSA / notifications panel (overlays content, below title bar)  -->
        <Border
            x:Name="FlyPsa"
            Grid.Row="1"
            Grid.RowSpan="2"
            Width="380"
            HorizontalAlignment="Right"
            Panel.ZIndex="100"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <DockPanel>
                <Border
                    Padding="14,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button
                                x:Name="BtnPsaMarkAllRead"
                                Height="28"
                                MinWidth="40"
                                Margin="0,0,4,0"
                                Appearance="Transparent"
                                Click="BtnPsaMarkAllRead_OnClick"
                                Content="All"
                                ToolTip="{DynamicResource common_mark_all_read}"
                                Visibility="Collapsed" />
                            <ui:Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                Appearance="Transparent"
                                Click="BtnPsaClose_OnClick"
                                ToolTip="{DynamicResource common_close}">
                                <ui:SymbolIcon
                                    Width="12"
                                    Height="12"
                                    Symbol="Dismiss24" />
                            </ui:Button>
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{DynamicResource menu_notifications}" />
                    </DockPanel>
                </Border>
                <ScrollViewer
                    Padding="12,10,12,12"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlPsas" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  Status bar: always visible at bottom  -->
        <Border
            Grid.Row="3"
            MinHeight="28"
            Padding="12,0,16,0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="TxtStatusApi"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ApiMetrics.TotalRequestsPerMinute, StringFormat=API: {0} rpm}"
                        Visibility="{Binding ApiMetrics.ShowTotalInStatusbar, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding TwitchApiBrush}" />
                    <TextBlock
                        Margin="6,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_main_status_twitch_api}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding TwitchBotBrush}" />
                    <TextBlock
                        Margin="6,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_main_status_twitch_bot}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding SpotifyBrush}" />
                    <TextBlock
                        Margin="6,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_main_status_spotify}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding PearBrush}"
                        ToolTip="{Binding PearStatusText}" />
                    <TextBlock
                        Margin="6,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_main_status_pear}"
                        ToolTip="{Binding PearStatusText}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding WebServerBrush}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource window_main_status_webserver}" />
                </StackPanel>
                <ui:Button
                    x:Name="BtnSpotifyIdleBackoff"
                    Grid.Column="1"
                    MinHeight="22"
                    Margin="12,0"
                    Padding="8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="BtnSpotifyIdleBackoff_Click"
                    Cursor="Hand"
                    ToolTip="{DynamicResource window_settings_spotify_idle_backoff_tooltip}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="IndianRed"
                            Symbol="Gauge24" />
                        <TextBlock
                            x:Name="TbSpotifyIdleBackoff"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="IndianRed"
                            Text="Polling 20s (idle)" />
                    </StackPanel>
                </ui:Button>
                <TextBlock
                    x:Name="LblCopyright"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusBarVersion}" />
            </Grid>
        </Border>

        <tray:NotifyIcon
            x:Name="TrayIcon"
            FocusOnLeftClick="True"
            Icon="pack://application:,,,/Resources/songify.ico"
            LeftDoubleClick="TrayIcon_OnLeftDoubleClick"
            MenuOnRightClick="True"
            TooltipText="Songify">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource menu_twitch}">
                        <MenuItem Click="TrayConnect_OnClick" Header="{DynamicResource menu_twitch_connect}" />
                        <MenuItem Click="TrayDisconnect_OnClick" Header="{DynamicResource menu_disconnect}" />
                    </MenuItem>
                    <MenuItem Click="TrayShow_OnClick" Header="{DynamicResource common_show}" />
                    <MenuItem Click="TrayExit_OnClick" Header="{DynamicResource menu_file_exit}" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>