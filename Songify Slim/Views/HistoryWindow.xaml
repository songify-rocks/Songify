<Window
    x:Class="Songify_Slim.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_history_title}"
    Width="588"
    Height="280"
    Closed="Window_Closed"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10,8,10,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton
                    x:Name="Tglbtn_Save"
                    Margin="0,0,6,0"
                    Padding="8,2"
                    Checked="Tglbtn_Save_Checked"
                    Content="Save"
                    Unchecked="Tglbtn_Save_Checked" />
                <Button
                    x:Name="BtnRefresh"
                    Padding="6,2"
                    Click="BtnRefresh_Click">
                    <ui:SymbolIcon
                        Width="15"
                        Height="15"
                        Symbol="ArrowSync24" />
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <DataGrid
                x:Name="dgvHistorySongs"
                Margin="148,10,10,8"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="DgvItemDelete_Click" Header="{DynamicResource common_delete}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Path=Time}"
                        Header="{DynamicResource common_time}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Path=Name}"
                        Header="{DynamicResource common_name}"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <ListBox
                x:Name="LbxHistory"
                Width="133"
                Margin="10,10,0,8"
                HorizontalAlignment="Left"
                SelectionChanged="LbxHistory_SelectionChanged">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItemDelete_Click" Header="{DynamicResource common_delete}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>

        <StatusBar
            Grid.Row="2"
            Height="18"
            Margin="0"
            Padding="0"
            VerticalAlignment="Bottom">
            <Label
                x:Name="Lbl_Status"
                Width="340"
                Margin="0,-2"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Bottom"
                FontSize="10"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StatusBar>
    </Grid>
</Window>
