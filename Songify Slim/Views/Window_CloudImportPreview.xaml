<ui:FluentWindow
    x:Class="Songify_Slim.Views.Window_CloudImportPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_cloudimport_title}"
    Width="720"
    Height="520"
    MinWidth="560"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{DynamicResource window_cloudimport_title}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,12"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_cloudimport_intro}"
                TextWrapping="Wrap" />

            <Border
                x:Name="PermissionWarningBanner"
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="#33FF9800"
                BorderBrush="#FFFF9800"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource window_cloudimport_permission_warning}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbPermissionWarnings"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ui:Card
                Grid.Row="2"
                Padding="0"
                VerticalAlignment="Stretch">
                <RichTextBox
                    x:Name="DiffTextBox"
                    Padding="12"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto" />
            </ui:Card>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="24,12,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="BtnCancel"
                MinWidth="96"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="BtnCancel_Click"
                Content="{DynamicResource common_cancel}"
                IsCancel="True" />
            <ui:Button
                x:Name="BtnImport"
                MinWidth="110"
                Appearance="Primary"
                Click="BtnImport_Click"
                Content="{DynamicResource window_cloudimport_import}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
