<ui:FluentWindow
    x:Class="Songify_Slim.Views.Window_CloudImportPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_cloudimport_title}"
    Width="760"
    Height="580"
    MinWidth="560"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="DlgTitleBar"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TbIntro"
                Margin="0,0,0,12"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource window_cloudimport_intro}"
                TextWrapping="Wrap" />

            <Border
                x:Name="PermissionWarningBanner"
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="#33FF9800"
                BorderBrush="#FFFF9800"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource window_cloudimport_permission_warning}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TbPermissionWarnings"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Click="BtnSelectAll_Click"
                    Content="{DynamicResource window_import_select_all}" />
                <ui:Button
                    Appearance="Secondary"
                    Click="BtnSelectNone_Click"
                    Content="{DynamicResource window_import_select_none}" />
                <TextBlock
                    x:Name="TbSelectionCount"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <ui:Card
                Grid.Row="3"
                Padding="0"
                VerticalAlignment="Stretch">
                <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiffList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0,0,0,8"
                                                    VerticalContentAlignment="Top"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding DisplayName}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            TextWrapping="Wrap">
                                                            <Run Text="{Binding OldText, Mode=OneWay}" />
                                                            <Run Text=" → " />
                                                            <Run Text="{Binding NewText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="24,12,24,20"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="BtnCancel"
                MinWidth="96"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="BtnCancel_Click"
                Content="{DynamicResource common_cancel}"
                IsCancel="True" />
            <ui:Button
                x:Name="BtnImport"
                MinWidth="110"
                Appearance="Primary"
                Click="BtnImport_Click"
                Content="{DynamicResource window_cloudimport_import}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
