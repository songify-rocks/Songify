<Window
    x:Class="Songify_Slim.Views.Window_Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Songify_Slim.Properties"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Songify_Slim.Views.WPFUI.Controls"
    Title="{DynamicResource menu_file_settings}"
    Width="860"
    Height="490"
    MinHeight="400"
    d:Title="{x:Static local:Resources.menu_file_settings}"
    Closing="Window_Closing"
    LocationChanged="Window_LocationChanged"
    ResizeMode="CanResizeWithGrip"
    SizeChanged="Window_SizeChanged"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="8,4"
            HorizontalAlignment="Right"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <Button
                Padding="10,4"
                d:Content="{x:Static local:Resources.window_settings_response_variables}"
                Click="BtnResponseParams_OnClick"
                Content="{DynamicResource window_settings_response_variables}" />
        </StackPanel>
        <settings:SettingsPanel x:Name="Panel" />
    </DockPanel>
</Window>
