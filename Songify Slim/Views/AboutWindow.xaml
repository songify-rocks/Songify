<Window
    x:Class="Songify_Slim.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource window_about_title}"
    Width="710"
    Height="490"
    MaxWidth="710"
    Loaded="Window_Loaded"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Content="{DynamicResource window_about_third_party}" />

        <ScrollViewer
            Grid.Column="0"
            Margin="0,25,0,14"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="5,0,0,0">
                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    Text="{DynamicResource window_about_licenses}" />

                <TextBlock Text="{DynamicResource window_about_libraries_intro}" TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,12"
                    Text="{DynamicResource window_about_license_notice}"
                    TextWrapping="Wrap" />

                <Separator Margin="0,0,0,12" />

                <ItemsControl x:Name="ThirdPartyItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />

                                <TextBlock>
                                    <Run Text="{DynamicResource window_about_license_label}" />
                                    <Run Text="{Binding License}" />
                                </TextBlock>

                                <TextBlock>
                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{Binding Url}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock
                Height="83"
                Margin="30,6"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <Run Text="{DynamicResource window_about_gpl_notice}" />
                <LineBreak /><Run /><LineBreak />
                <Run Text="{DynamicResource window_about_discord_invite}" />
            </TextBlock>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Label
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{DynamicResource window_about_thank_you}"
                    FontWeight="Bold" />
                <ui:SymbolIcon
                    Width="16"
                    Height="16"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Symbol="Heart24" />
            </StackPanel>
            <TextBlock
                Margin="6,0"
                HorizontalAlignment="Left"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{DynamicResource window_about_credits}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
