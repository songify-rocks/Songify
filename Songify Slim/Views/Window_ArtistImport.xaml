<ui:FluentWindow
    x:Class="Songify_Slim.Views.Window_ArtistImport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Import artists"
    Width="580"
    Height="600"
    MinWidth="480"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Import artists"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Load a CSV from a file or HTTPS URL, map Name/Id columns, then import into the artist block list."
                    TextWrapping="Wrap" />

                <ui:Card Margin="0,0,0,12" Padding="14">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="SOURCE" />

                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <RadioButton
                                x:Name="RbImportFile"
                                MinWidth="56"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Checked="ImportSource_Checked"
                                Content="File"
                                DockPanel.Dock="Left"
                                GroupName="ImportSource"
                                IsChecked="True" />
                            <ui:Button
                                x:Name="BtnImportBrowse"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Click="ImportBrowse_Click"
                                Content="Browse…"
                                DockPanel.Dock="Right" />
                            <ui:TextBox
                                x:Name="TbImportFilePath"
                                PlaceholderText="No file selected"
                                IsReadOnly="True" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <RadioButton
                                x:Name="RbImportUrl"
                                MinWidth="56"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Checked="ImportSource_Checked"
                                Content="URL"
                                DockPanel.Dock="Left"
                                GroupName="ImportSource" />
                            <ui:TextBox
                                x:Name="TbImportUrl"
                                PlaceholderText="https://…"
                                Text="https://raw.githubusercontent.com/CennoxX/spotify-ai-blocker/refs/heads/main/SpotifyAiArtists.csv" />
                        </DockPanel>

                        <ui:Button
                            MinWidth="110"
                            HorizontalAlignment="Right"
                            Appearance="Primary"
                            Click="ImportLoad_Click"
                            Content="Load CSV" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Name column" />
                            <ComboBox
                                x:Name="CbxImportNameColumn"
                                MinHeight="32"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Index"
                                SelectionChanged="ImportColumnMapping_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Id column (optional)" />
                            <ComboBox
                                x:Name="CbxImportIdColumn"
                                MinHeight="32"
                                DisplayMemberPath="Display"
                                SelectedValuePath="Index"
                                SelectionChanged="ImportColumnMapping_Changed" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="180" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="14,12,14,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="PREVIEW" />
                        <ListBox
                            x:Name="LbImportPreview"
                            Grid.Row="1"
                            MaxHeight="260"
                            Margin="0,0,0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding ImportPreviewRows}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            FontSize="12"
                                            FontFamily="Consolas"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Id}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ui:Card>

                <TextBlock
                    x:Name="TbImportStatus"
                    Margin="0,12,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="No CSV loaded."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12,24,20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Click="ImportCancel_Click"
                    Content="{DynamicResource common_cancel}"
                    IsCancel="True" />
                <ui:Button
                    x:Name="BtnImportConfirm"
                    MinWidth="110"
                    Appearance="Primary"
                    Click="ImportConfirm_Click"
                    Content="Import"
                    IsDefault="True"
                    IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
