<UserControl
    x:Class="Songify_Slim.Views.ApiChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Songify_Slim.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid MinHeight="0">
        <lvc:CartesianChart
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Series="{Binding SeriesCollection}"
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            LegendPosition="Top"
            LegendTextPaint="{Binding LegendTextPaint}"
            LegendTextSize="12"
            TooltipPosition="Auto"
            TooltipFindingStrategy="CompareOnlyX"
            TooltipTextPaint="{Binding TooltipTextPaint}"
            TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
            TooltipTextSize="12" />
    </Grid>
</UserControl>